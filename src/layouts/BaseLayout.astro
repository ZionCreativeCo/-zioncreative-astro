---
import '../styles/global.css';
import shareImages from '../data/share-images.json';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const live = import.meta.env.PUBLIC_SITE_LIVE === 'true' && !noindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pagePath = Astro.url.pathname.replace(/\/$/, '') || '/';
const shareImage = shareImages[pagePath as keyof typeof shareImages] || shareImages.default;
const shareImageUrl = new URL(shareImage.src, Astro.site);
const website = {
 '@context':'https://schema.org', '@type':'WebSite',
 '@id':'https://www.zioncreative.co/#website', name:'Zion Creative',
 url:'https://www.zioncreative.co/', inLanguage:'en-US',
 publisher:{'@id':'https://www.zioncreative.co/#organization'}
};
const organization = {
 '@context':'https://schema.org', '@type':'Organization',
 '@id':'https://www.zioncreative.co/#organization', name:'Zion Creative',
 url:'https://www.zioncreative.co/', logo:'https://www.zioncreative.co/images/logo.webp',
 description:'Independent design studio based in Springfield, Illinois, providing branding, website design, graphic design, and ongoing creative support.',
 email:'hello@zioncreative.co', telephone:'+1-217-725-2031', foundingDate:'2017',
 areaServed:[{'@type':'City',name:'Springfield, Illinois'},{'@type':'City',name:'Sherman, Illinois'}],
 knowsAbout:['Brand identity design','Website design and development','Graphic design','Digital marketing']
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {Astro.url.pathname === '/' && <meta name="msvalidate.01" content="02B6A1353FB71ABB0855375FEC11910C" />}
    <meta name="robots" content={live ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zion Creative" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={shareImage.width} />
    <meta property="og:image:height" content={shareImage.height} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    {Astro.url.pathname === "/" && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
    {Astro.url.pathname === "/" && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
