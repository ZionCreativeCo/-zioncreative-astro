---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import ScrollMotion from '../components/ScrollMotion.astro';
import '../styles/secondary.css';
import '../styles/remaining.css';
---
<BaseLayout title="Colossus — Custom Webflow Development | Zion Creative" description="A custom Webflow experience for Colossus. Website design by the Colossus team; website development by Nick VanMeter at Zion Creative.">
<Header />
<main id="main" class="case-page">
<section class="container page-intro case-intro"><a class="text-link case-back" href="/portfolio">All work <Arrow /></a><p class="eyebrow">Selected work / Custom Webflow development</p><h1>Colossus.</h1><p class="case-deck">Big creative energy.<br />A custom digital experience.</p></section>
<section class="container colossus-stage" aria-label="Colossus desktop website"><div class="browser-frame"><div class="browser-bar" aria-hidden="true"><span>● ● ●</span><span>wearecolossus.com</span><span>↗</span></div><img src="/images/colossus-home.jpg" width="1280" height="720" alt="Colossus homepage: bold typography over a cinematic agency reel" fetchpriority="high" /></div></section>
<section class="container case-overview"><div class="case-summary rich-copy"><p class="eyebrow">The project</p><p>Colossus’s website brings the agency’s personality and creative work into one expressive digital experience.</p><p>The Colossus team designed the website. Nick VanMeter at Zion Creative developed their vision as a custom Webflow experience, bringing the design into a working website across desktop and mobile.</p></div><aside class="case-scope"><p class="eyebrow">Our role</p><p class="role-copy">Custom Webflow development</p><dl><div><dt>Website design</dt><dd>Colossus team</dd></div><div><dt>Website development</dt><dd>Nick VanMeter / Zion Creative</dd></div><div><dt>Platform</dt><dd>Webflow</dd></div><div><dt>Client</dt><dd>Colossus</dd></div></dl><a class="text-link" href="https://www.wearecolossus.com/" target="_blank" rel="noopener noreferrer">Visit website <Arrow /></a></aside></section>
<section class="container case-section"><div class="section-heading"><div><p class="eyebrow">The experience in motion</p><h2>Made to move.</h2></div><p class="colossus-note">A look at the Colossus reel featured on the live website. Creative and film by Colossus.</p></div><div class="colossus-film"><video controls playsinline preload="metadata" poster="/images/colossus-home.jpg" aria-label="Colossus website agency reel"><source src="/images/colossus-reel-preview.mp4" type="video/mp4" />Your browser cannot play this video.</video></div><p class="media-credit">Website design, agency reel & featured creative: Colossus. Custom Webflow development: Nick VanMeter / Zion Creative.</p></section>
<section class="container colossus-responsive"><div><p class="eyebrow">From desktop to mobile</p><h2>One personality.<br /><em>Every screen.</em></h2><p class="intro-copy">The same creative voice, presented across a spacious desktop canvas and a focused mobile experience.</p><div class="browser-frame work-screen"><div class="browser-bar" aria-hidden="true"><span>● ● ●</span><span>wearecolossus.com/work</span><span>↗</span></div><img src="/images/colossus-work.jpg" width="1280" height="720" alt="Colossus work index with project filtering and featured creative work" loading="lazy" /></div></div><figure class="phone-frame"><img src="/images/colossus-mobile.jpg" width="390" height="844" alt="Colossus homepage captured on a mobile screen" loading="lazy" /></figure></section>
<ProjectCTA />
</main><Footer /><ScrollMotion />
</BaseLayout>
<style>
.colossus-stage{padding:55px clamp(20px,5vw,80px);background:#dedfd4;border-radius:5px}.browser-frame{border:1px solid #24251b38;border-radius:12px;overflow:hidden;box-shadow:0 24px 55px #20231c22;background:#eeefea}.browser-bar{display:flex;justify-content:space-between;padding:12px 18px;font-size:11px;color:#64665f}.browser-bar span:first-child{letter-spacing:3px;font-size:9px}.browser-frame img{width:100%;height:auto;display:block}.colossus-note{max-width:350px;font-size:15px;color:var(--muted)}.colossus-film{overflow:hidden;border-radius:5px;background:#111}.colossus-film video{width:100%;display:block;aspect-ratio:16/9}.media-credit{font-size:12px;margin-top:16px;color:var(--muted)}.colossus-responsive{display:grid;grid-template-columns:1fr 280px;gap:80px;align-items:center;margin-top:90px;margin-bottom:110px}.work-screen{margin-top:40px}.phone-frame{margin:0;border:9px solid #20211e;border-radius:42px;overflow:hidden;box-shadow:0 25px 45px #20231c25;position:relative}.phone-frame:before{content:'';position:absolute;top:8px;left:50%;transform:translateX(-50%);width:75px;height:18px;background:#20211e;border-radius:18px}.phone-frame img{width:100%;display:block}@media(max-width:760px){.colossus-stage{padding:25px 12px}.browser-bar{padding:8px;font-size:8px}.colossus-responsive{grid-template-columns:1fr;gap:40px;margin:55px auto 65px}.phone-frame{max-width:260px;justify-self:center}.colossus-note{margin-top:18px}.section-heading{flex-wrap:wrap}}
</style>
