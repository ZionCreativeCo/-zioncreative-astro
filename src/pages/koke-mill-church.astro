---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import CaseTemplate from '../components/CaseTemplate.astro';
import ScrollableScreen from '../components/ScrollableScreen.astro';
import CaseFilm from '../components/CaseFilm.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import screens from '../data/kmcc-screens.json';
import '../styles/secondary.css';
---
<BaseLayout title="Koke Mill Church, Custom Squarespace Website | Zion Creative" description="A custom Squarespace website for Koke Mill Church, with an authentic, memorable, and comfortable experience for visitors and members."><Header/><main id="main"><CaseTemplate name="Koke Mill Church" tagline="An authentic community. A comfortable digital welcome." related={['/evangel','/project/vpne','/colossus']}>
<div slot="hero" class="kmcc-stage"><div class="container"><ScrollableScreen image={screens.home} title="Homepage" address="kokemillchurch.org" brand="Koke Mill Church" primary/></div></div>
<section class="container clean-story-section kmcc-intro"><p class="eyebrow">The project</p><div class="clean-story-copy"><h2>A familiar feeling.<br/>A distinctly custom experience.</h2><p>Koke Mill Church’s website was designed to feel authentic, memorable, and comfortable. A custom Squarespace experience brings the community’s personality into a welcoming digital space for both newcomers and members.</p><p>Real photography, clear next steps, and a consistent visual language help visitors explore the church and find their place.</p><p>Built for Koke Mill Church in Springfield, Illinois, this project brings local community stories into a custom Squarespace experience. Learn more about our <a class="text-link" href="/web-design-springfield-il">website design for Springfield businesses and nonprofits</a>.</p></div><div class="clean-case-credits kmcc-credits"><div><strong>Our role</strong>Custom website design &amp; development</div><div><strong>Platform</strong>Squarespace</div><div><strong>Category</strong>Church / Non-Profit</div><a href="https://www.kokemillchurch.org/" class="text-link kmcc-live" target="_blank" rel="noopener noreferrer">Explore the live site <Arrow/></a></div></section>
<section class="container clean-story-section"><p class="eyebrow">The experience</p><div class="clean-story-copy"><h2>More than individual pages.<br/>One connected experience.</h2><p>The recording below shows how the custom experience feels as visitors move through the site. Shared card styles, imagery, and navigation create a recognizable rhythm across the pages.</p></div></section>
<CaseFilm name="kmcc-experience" label="Koke Mill Church custom website navigation demonstration" src="/videos/kmcc-experience.mp4" poster="/images/kmcc-experience-poster.jpg" width={1600} height={1000} address="kokemillchurch.org"/>
<section class="container clean-story-section"><p class="eyebrow">Beyond the homepage</p><div class="clean-story-copy"><h2>Get to know the church.<br/>Find a way to connect.</h2><p>The About page introduces the mission, vision, and values. The Gather page connects visitors with ministries, volunteer teams, and baptism information. Both carry the same comfortable, people-focused approach.</p></div></section>
<div class="kmcc-stage"><div class="container kmcc-screens"><ScrollableScreen image={screens.about} title="About Koke Mill" address="kokemillchurch.org / new" brand="Koke Mill Church"/><ScrollableScreen image={screens.gather} title="Gather" address="kokemillchurch.org / gather" brand="Koke Mill Church"/></div></div>
<section class="clean-impact"><div class="container clean-impact-inner"><div class="kmcc-outcomes"><p><strong>Custom Squarespace</strong>A distinctive website experience on a familiar platform.</p><p><strong>Clear next steps</strong>Paths for visiting, gathering, and getting involved.</p><p><strong>Authentic storytelling</strong>The church’s people and community lead the visuals.</p></div><div class="clean-impact-copy"><p class="eyebrow">The result</p><h2>Memorable by design.<br/>Welcoming by nature.</h2><p>The website brings together expressive design and practical information, giving Koke Mill Church a digital home that feels personal and easy to explore.</p></div></div></section>
</CaseTemplate><ProjectCTA/></main><Footer/></BaseLayout>
<style>.kmcc-stage{background:#e6e2da;padding:55px 0}.kmcc-intro{row-gap:30px}.kmcc-credits{grid-column:2;margin-top:0;align-items:center;gap:20px 30px}.kmcc-live{margin-left:auto;font-size:14px;white-space:nowrap}.kmcc-screens{display:grid;grid-template-columns:1fr 1fr;gap:35px}.kmcc-outcomes{display:grid;gap:25px}.kmcc-outcomes p{font-size:14px;line-height:1.5;color:#66635d}.kmcc-outcomes strong{display:block;font-size:24px;color:var(--ink);font-weight:500;margin-bottom:8px}@media(max-width:1000px){.kmcc-live{margin-left:0}}@media(max-width:760px){.kmcc-stage{padding:30px 0}.kmcc-screens{grid-template-columns:1fr}.kmcc-credits{grid-column:1}}</style>
