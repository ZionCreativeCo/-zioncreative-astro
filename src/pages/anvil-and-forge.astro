---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import Media from '../components/Media.astro';
import CaseFilm from '../components/CaseFilm.astro';
import ExpandingGallery from '../components/ExpandingGallery.astro';
import media from '../data/media.json';
import CaseTemplate from '../components/CaseTemplate.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import pages from '../data/pages.json';
import impact from '../data/anvil-impact.json';
import '../styles/secondary.css';
const content=pages.find(page=>page.slug==='anvil-and-forge')!;
const photoItems=[
 {id:'eb3d42e9ffad',alt:'Anvil & Forge wall lettering in the brick brewery interior'},
 {id:'b6a0d9bdaaf2',alt:'Anvil & Forge branded tap handles in the brewery'},
 {id:'567350fa7583',alt:'A bartender pours a craft beer at Anvil & Forge'},
 {id:'e78d623c020a',alt:'A warm drink on a wooden table in the brewery'},
 {id:'8aba965641ae',alt:'Coffee being prepared at Anvil & Forge'},
 {id:'56a0334d4eea',alt:'Anvil & Forge glassware beside a sunlit brewery window'},
 {id:'f4697041cfad',alt:'Anvil & Forge lettering on the downtown Springfield building'}];
const photos=photoItems.map(photo=>({...media[photo.id as keyof typeof media],alt:photo.alt,position:photo.id==='567350fa7583'?'60%':'50%'}));
---
<BaseLayout title={content.title} description={content.description.trim()}>
<Header/><main id="main"><CaseTemplate name="Anvil & Forge" tagline="Local craft. A brand with character." related={['/the-villas','/colossus','/little-pond']}>
<CaseFilm slot="hero" name="anvil-home-scroll" label="Scrolling video of the Anvil & Forge website" src="/videos/anvil-home-scroll.mp4" poster="/images/anvil-home-scroll-poster.jpg" width={1600} height={1000} address="anvilandforge.com"/>
<section class="container clean-story-section anvil-intro" aria-labelledby="anvil-story"><p class="eyebrow">The partnership</p><div class="clean-story-copy"><h2 id="anvil-story">Crafted locally.<br/>Connected everywhere.</h2>{content.paragraphs[0].split('\n\n').map(p=><p>{p}</p>)}</div><div class="clean-case-credits anvil-credits"><div><strong>Client</strong>Anvil & Forge</div><div><strong>Our role</strong>{content.roles}</div><div><strong>Project</strong>Food & beverage · Q2 2021</div><a class="text-link credits-live-link" href={content.liveUrl} target="_blank" rel="noopener noreferrer">Explore the live site <Arrow/></a></div></section>
<section class="container clean-story-section" aria-labelledby="anvil-web"><p class="eyebrow">Website</p><div class="clean-story-copy"><h2 id="anvil-web">A digital home for local craft.</h2><p>The website brings the brewery’s character into a connected experience, giving visitors a place to explore the beer, the taproom, and what’s happening next.</p></div></section>

<div class="anvil-kitchen"><div class="container kitchen-pair"><figure class="browser-frame"><div class="browser-bar"><span>● ● ●</span><span>anvilandforge.com / the-foundry-kitchen</span></div><img src="/images/anvil-foundry-kitchen.webp" width="1280" height="720" alt="The live Foundry Kitchen website hero with food photography, the kitchen name, and opening hours" loading="lazy"/></figure><figure class="browser-frame"><div class="browser-bar"><span>● ● ●</span><span>The Foundry Kitchen / Menu</span></div><img src="/images/anvil-foundry-menu.webp" width="1280" height="720" alt="The Foundry Kitchen website menu with category navigation, dishes, descriptions, and prices" loading="lazy"/></figure></div></div>
<section class="container clean-story-section" aria-labelledby="anvil-packaging"><p class="eyebrow">Brand & packaging</p><div class="clean-story-copy"><h2 id="anvil-packaging">Character you can take home.</h2><p>Branding and packaging carry the same distinctive personality from the taproom to the shelf, with expressive can designs built around the beers themselves.</p></div></section>
<div class="container anvil-cans"><figure><Media id="66d1a1bd4a44" alt="Two Hibiscus, I’m Very Cherry craft beer cans with pink Anvil & Forge packaging"/></figure><figure><Media id="5c8a2685ae1d" alt="Anvil & Forge craft beer can packaging with a blue paint splash design"/></figure><figure><Media id="f73a1998d45d" alt="A lineup of Anvil & Forge beer cans with a coordinated black packaging system"/></figure></div>
<section class="container clean-story-section" aria-labelledby="anvil-photo"><p class="eyebrow">Photography</p><div class="clean-story-copy"><h2 id="anvil-photo">The craft. The space.<br/>The people behind it.</h2><p>Photography captures the details that make the brewery its own, from the tap handles and glassware to the people pouring the next round.</p></div></section>
<div class="container"><ExpandingGallery photos={photos} name="Anvil & Forge" rowSize={7}/></div>
<section class="clean-impact" aria-labelledby="anvil-impact"><div class="container clean-impact-inner"><div><div class="clean-impact-facts">{impact.metrics.map(metric=><p><strong>{metric.value}</strong>{metric.label}</p>)}</div><p class="metrics-source">{impact.source}<br/>{impact.period}.</p></div><div class="clean-impact-copy"><p class="eyebrow">Impact</p><h2 id="anvil-impact">Found in search.<br/>Ready for what’s next.</h2><p>The website gives Anvil & Forge a visible presence in organic search and a home that can grow alongside the business.</p></div></div></section>
<section class="container clean-story-section anvil-testimonial" aria-label="Client testimonial"><p class="eyebrow">In their words</p><div><blockquote>“{content.quote}”</blockquote><p class="attribution">{content.attribution}</p></div></section>
</CaseTemplate><ProjectCTA/></main><Footer/>
</BaseLayout>
<style>
.anvil-intro{row-gap:30px}.anvil-credits{grid-column:2;margin-top:0;gap:20px 30px;align-items:center}.credits-live-link{margin-left:auto;font-size:14px;white-space:nowrap}.anvil-kitchen{background:#e4dfd5;padding:55px 0}.kitchen-pair{display:grid;grid-template-columns:1fr 1fr;gap:25px}.browser-frame{margin:0;border:1px solid #adaaa1;border-radius:10px;overflow:hidden;box-shadow:0 20px 40px #25231b20;background:#efefea}.browser-bar{padding:12px 15px;display:flex;gap:20px;align-items:center;justify-content:space-between;font-size:9px;color:#74736b}.browser-bar span:first-child{font-size:7px;letter-spacing:2px}.browser-frame img{width:100%;height:auto;display:block}.anvil-cans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;padding-bottom:35px;align-items:stretch}.anvil-cans figure{margin:0;background:#ececea;display:flex;align-items:center;overflow:hidden;border-radius:6px}.anvil-cans :global(picture){display:block;width:100%}.anvil-cans :global(img){width:100%;height:350px;object-fit:cover;display:block}.metrics-source{font-size:11px;line-height:1.6;color:#68655f;margin-top:30px;max-width:350px}.anvil-testimonial blockquote{font-size:clamp(24px,2.7vw,36px);line-height:1.4;letter-spacing:-.025em;margin:0;max-width:850px}.attribution{font-size:13px;margin-top:25px;color:#68665f}@media(max-width:1000px){.anvil-credits{gap:20px}.credits-live-link{margin-left:0}.anvil-cans :global(img){height:270px}}@media(max-width:760px){.anvil-credits{grid-column:1}.kitchen-pair{grid-template-columns:1fr;gap:20px}.anvil-kitchen{padding:30px 0}.anvil-cans{grid-template-columns:1fr;gap:12px;padding-bottom:15px}.anvil-cans :global(img){height:350px;object-fit:cover}.browser-bar{font-size:8px;gap:8px}}
</style>
