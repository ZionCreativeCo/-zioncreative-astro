---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CaseTemplate from '../components/CaseTemplate.astro';
import Media from '../components/Media.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import pages from '../data/pages.json';
import '../styles/secondary.css';
const page=pages.find(p=>p.slug==='little-pond')!;
---
<BaseLayout title={page.title} description={page.description.trim()}><Header/><main id="main"><CaseTemplate name="Little Pond" tagline="A little warmth. A world of possibility." related={['/evangel','/bfg','/pillars-yogurt']}>
<div slot="hero" class="pond-identity"><div class="container pond-logo"><Media id="bc752b42bc47" alt="Little Pond logo with a home inside an organic green shape" eager/><p>Childcare resources for parents and providers.</p></div></div>
<section class="container clean-story-section"><p class="eyebrow">The beginning</p><div class="clean-story-copy"><h2>A public resource.<br/>A personal welcome.</h2><p>As a new entity established by the state of Georgia, Little Pond needed to feel approachable rather than like another stale government initiative. We were brought on to provide creative direction and build the brand from the ground up.</p><div class="clean-case-credits"><div><strong>Our role</strong>Creative direction · Design · Brand identity · Website design</div></div></div></section>
<section class="pond-system" aria-labelledby="pond-system-title"><div class="container pond-system-grid"><div class="pond-mark"><Media id="76e6b00ce8e4" alt="Little Pond home symbol"/></div><div class="pond-system-copy"><p class="eyebrow">The identity</p><h2 id="pond-system-title">Simple shapes.<br/>A familiar feeling.</h2><p>A home anchors the mark. Soft, organic shapes and a warm green palette give the identity a friendly character, with sunshine yellow and bright blue adding energy.</p><div class="pond-icons"><Media id="0f5c961a716b" alt="Little Pond supporting heart, sunshine, and smile icons"/></div></div></div></section>
<section class="container pond-type"><div><p class="eyebrow">The visual language</p><h2>Room to play.<br/>Easy to read.</h2><p>Rounded lettering, expressive shapes, and a clear hierarchy carry the welcoming tone across the brand.</p></div><Media id="9d2d0bd5cb6c" alt="Little Pond color palette and typography specifications"/></section>
<div class="pond-applications"><div class="container pond-application-grid"><figure><Media id="7a5ed81d6fe2" alt="Little Pond identity on a green sweatshirt"/><figcaption>A brand that feels at home.</figcaption></figure><figure><Media id="73e9efbb3bb3" alt="Child wearing a Little Pond branded sweatshirt while playing"/><figcaption>Built around the families it serves.</figcaption></figure></div></div>
<section class="container pond-web"><div class="pond-web-copy"><p class="eyebrow">The website</p><h2>From a friendly identity<br/>to a useful resource.</h2><p>The website direction brings the same approachable shapes, colors, and photography into a digital home for childcare resources.</p></div><div class="pond-laptop"><Media id="6e1c86a702fa" alt="Little Pond website shown on a laptop"/></div></section>
<section class="pond-final"><div class="container pond-final-grid"><div><p class="eyebrow">The brand in practice</p><h2>Small details.<br/>A consistent welcome.</h2><p>The identity’s shapes and color carry through the supporting artwork, keeping the message rooted in care, community, and connection.</p></div><div class="pond-art"><Media id="c10c006b9991" alt="Little Pond artwork promoting local home daycare providers"/></div></div></section>
</CaseTemplate><ProjectCTA/></main><Footer/></BaseLayout>
<style>
.pond-identity{background:#eaf2eb;padding:100px 0 80px}.pond-logo{max-width:980px;text-align:center}.pond-logo :global(img){width:100%;height:auto}.pond-logo p{margin-top:45px;font-size:17px;color:#4d6553}.pond-system{background:#dce8dc;padding:75px 0}.pond-system-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:110px;align-items:center}.pond-mark{max-width:290px;margin:auto}.pond-mark :global(img),.pond-icons :global(img){width:100%;height:auto}.pond-system-copy h2,.pond-type h2,.pond-web h2,.pond-final h2{font-size:clamp(30px,3.5vw,48px);line-height:1.1;letter-spacing:-.03em;margin:18px 0 25px}.pond-system-copy p:not(.eyebrow),.pond-type p:not(.eyebrow),.pond-web p:not(.eyebrow),.pond-final p:not(.eyebrow){font-size:17px;line-height:1.7;color:#555d55;max-width:490px}.pond-icons{max-width:390px;margin-top:40px}.pond-type{display:grid;grid-template-columns:.8fr 1.2fr;gap:100px;align-items:center;padding-block:90px}.pond-type :global(img){width:100%;height:auto;border-radius:12px}.pond-applications{background:#efece5;padding:55px 0}.pond-application-grid{display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:start}.pond-application-grid figure{margin:0}.pond-application-grid :global(img){width:100%;height:auto;border-radius:12px}.pond-application-grid figcaption{font-size:13px;color:#65655d;margin-top:18px}.pond-application-grid figure:last-child{padding-top:85px}.pond-web{display:grid;grid-template-columns:.8fr 1.2fr;gap:65px;align-items:center;padding-block:90px}.pond-laptop :global(img){width:100%;height:auto}.pond-final{background:#eaf2eb;padding:75px 0}.pond-final-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}.pond-art{max-width:440px;margin-left:auto}.pond-art :global(img){width:100%;height:auto;border-radius:12px}@media(max-width:760px){.pond-identity{padding:60px 0 45px}.pond-logo p{font-size:14px;margin-top:25px}.pond-system,.pond-final{padding:45px 0}.pond-system-grid,.pond-type,.pond-web,.pond-final-grid{grid-template-columns:1fr;gap:35px}.pond-mark{max-width:180px}.pond-type,.pond-web{padding-block:45px}.pond-applications{padding:30px 0}.pond-application-grid{grid-template-columns:1fr;gap:30px}.pond-application-grid figure:last-child{padding-top:0}.pond-art{margin:0;max-width:none}}
</style>
