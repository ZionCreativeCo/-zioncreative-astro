---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CaseTemplate from '../components/CaseTemplate.astro';
import Media from '../components/Media.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import pages from '../data/pages.json';
import '../styles/secondary.css';
const page=pages.find(p=>p.slug==='lingk')!;
---
<BaseLayout title={page.title} description={page.description.trim()}><Header/><main id="main"><CaseTemplate name="Lingk" tagline="Connected by design. Built for innovation." related={['/little-pond','/garrison-group','/bfg']}>
<div slot="hero" class="lingk-hero"><div class="container"><Media id="795bc88274b7" alt="Lingk wordmark and colorful interlocking symbol" eager/><p>Unparalleled data innovation.</p></div></div>
<section class="container clean-story-section"><p class="eyebrow">The partnership</p><div class="clean-story-copy"><h2>A connected identity.<br/>A new creative direction.</h2><p>{page.paragraphs[0]}</p><div class="clean-case-credits"><div><strong>Our role</strong>Creative direction · Brand identity · Logo · Illustration · Website design · Iconography</div></div></div></section>
<section class="lingk-illustration"><div class="container"><Media id="fdfbe6e59364" alt="Lingk illustration of people connected through digital devices and data systems"/></div></section>
<section class="container lingk-pair"><div><p class="eyebrow">The identity</p><h2>Many parts.<br/>One recognizable mark.</h2><p>The interlocking symbol gives connection a clear visual form. Four bright colors bring energy to the mark, balanced by a deep navy wordmark.</p></div><div class="lingk-symbol"><Media id="e9e45d02e398" alt="Lingk interlocking symbol in yellow, pink, teal, and blue"/></div></section>
<section class="lingk-system"><div class="container lingk-pair"><Media id="aa98d86f7ab0" alt="Lingk brand color palette and typography specifications"/><div><p class="eyebrow">The visual system</p><h2>Bright accents.<br/>A consistent voice.</h2><p>A vivid palette and bold display type create a flexible foundation for the rebrand. Light lavender backgrounds give the illustrations room to breathe, while navy anchors the supporting content.</p></div></div></section>
<section class="container lingk-pair"><div><p class="eyebrow">Illustration</p><h2>Complex ideas.<br/>An approachable story.</h2><p>The illustration direction brings people, learning, and technology together. A shared palette and graphic style tie the scenes back to the identity.</p></div><Media id="d781dd4d8b85" alt="Lingk illustration connecting education, people, and digital technology"/></section>
<section class="lingk-web"><div class="container lingk-pair"><Media id="eb40e24b0d92" alt="Lingk website design displayed on a laptop"/><div><p class="eyebrow">Website design</p><h2>The system,<br/>brought together.</h2><p>The website design combines clear content, colorful accents, and supporting illustrations in a cohesive digital expression of the brand.</p></div></div></section>
<section class="container clean-story-section"><p class="eyebrow">Brand applications</p><div class="clean-story-copy"><h2>A recognizable identity.<br/>Beyond the screen.</h2><p>The mark and palette carry into branded merchandise, extending the same visual language into everyday touchpoints.</p></div></section>
<div class="container lingk-merch"><figure><Media id="214b3a04e3a5" alt="Navy Lingk hoodie with colorful symbol and Innovate Transform lettering"/></figure><figure><Media id="920059aa405b" alt="Lingk logo and brand colors applied to a reusable tumbler"/></figure></div>
</CaseTemplate><ProjectCTA/></main><Footer/></BaseLayout>
<style>
.lingk-hero{background:#efedfc;padding:65px 0 50px}.lingk-hero .container{max-width:960px}.lingk-hero :global(img){width:100%;height:auto}.lingk-hero p{text-align:center;margin-top:30px;color:#484270;font-size:15px}.lingk-illustration{background:#e7e3fa;padding:60px 0}.lingk-illustration .container{max-width:1040px}.lingk-illustration :global(img){width:100%;height:auto}.lingk-pair{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center;padding-block:80px}.lingk-pair h2{font-size:clamp(30px,3.5vw,46px);line-height:1.12;letter-spacing:-.03em;margin:18px 0 25px}.lingk-pair p:not(.eyebrow){font-size:17px;line-height:1.7;color:#615d70;max-width:470px}.lingk-pair :global(img){width:100%;height:auto}.lingk-symbol{max-width:340px;margin:auto}.lingk-system{background:#efedfc}.lingk-system :global(img){border-radius:12px}.lingk-web{background:#e7e3fa}.lingk-merch{display:grid;grid-template-columns:1.2fr .8fr;gap:35px;padding-bottom:75px;align-items:start}.lingk-merch figure{margin:0}.lingk-merch :global(img){width:100%;height:auto;border-radius:12px}.lingk-merch figure:last-child{max-width:360px;margin-left:auto}@media(max-width:760px){.lingk-hero{padding:40px 0 35px}.lingk-illustration{padding:35px 0}.lingk-pair{grid-template-columns:1fr;gap:35px;padding-block:45px}.lingk-symbol{max-width:230px}.lingk-merch{grid-template-columns:1fr;gap:25px;padding-bottom:45px}.lingk-merch figure:last-child{max-width:none;margin:0}.lingk-merch figure:last-child :global(img){max-height:540px;object-fit:cover;object-position:50% 35%}}
</style>
