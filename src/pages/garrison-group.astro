---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CaseTemplate from '../components/CaseTemplate.astro';
import Media from '../components/Media.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import pages from '../data/pages.json';
import '../styles/secondary.css';
const page=pages.find(p=>p.slug==='garrison-group')!;
---
<BaseLayout title={page.title} description={page.description.trim()}><Header/><main id="main"><CaseTemplate name="Garrison Group" tagline="A strong foundation. A distinctive identity." related={['/little-pond','/bfg','/pillars-yogurt']}>
<div slot="hero" class="garrison-logo"><div class="container"><Media id="8d6e137c68e4" alt="Garrison Group burgundy logo and architectural G symbol" eager/><p>Midwest commercial real estate advisors.</p></div></div>
<section class="container clean-story-section"><p class="eyebrow">The partnership</p><div class="clean-story-copy"><h2>Built on experience.<br/>Ready for a new chapter.</h2><p>Garrison Group has a history of commitment and dedication to clients throughout the Midwest. During a season of expansion, transition, and growth, the firm wanted an identity that better reflected its expertise and professionalism.</p><p>We partnered with the team to provide creative direction and build an adaptable brand system that could support the business for years to come.</p><div class="clean-case-credits"><div><strong>Our role</strong>Creative direction · Brand identity · Logo design</div></div></div></section>
<div class="garrison-sign"><Media id="a25495be4a98" alt="Garrison Group branding on exterior building signage"/></div>
<section class="container garrison-mark"><div><p class="eyebrow">The mark</p><h2>Architectural lines.<br/>An unmistakable G.</h2><p>The symbol combines the initial with bold, building-like forms. Its stacked lines give the identity a structural character that connects naturally with commercial real estate.</p></div><div class="garrison-symbol"><Media id="1fc7006146f4" alt="White architectural Garrison Group symbol"/></div></section>
<section class="garrison-language"><div class="container garrison-language-grid"><Media id="407ec7adfa43" alt="Garrison Group burgundy and charcoal palette with typography specifications"/><div><p class="eyebrow">The visual system</p><h2>Bold where it matters.<br/>Clear in every detail.</h2><p>Deep burgundy, charcoal, and light neutrals establish a confident palette. Condensed display typography gives the brand a strong voice, balanced by readable supporting type.</p></div></div></section>
<div class="garrison-apparel container"><Media id="0b1a2f67cd46" alt="Garrison Group embroidered logo on burgundy and white team apparel"/></div>
<section class="container clean-story-section"><p class="eyebrow">The result</p><div class="clean-story-copy"><h2>A cohesive identity.<br/>Made to move with the business.</h2><p>The rebrand brings the firm’s professionalism into a consistent visual language. From building signage to team apparel, the mark and supporting system give Garrison Group a recognizable presence.</p></div></section>
</CaseTemplate><ProjectCTA/></main><Footer/></BaseLayout>
<style>
.garrison-logo{background:#eeeae6;padding:75px 0 55px}.garrison-logo .container{max-width:1050px}.garrison-logo :global(img){width:100%;height:auto}.garrison-logo p{text-align:center;font-size:15px;color:#625b57;margin-top:35px}.garrison-sign :global(img){width:100%;height:auto;display:block}.garrison-mark{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center;padding-block:85px}.garrison-mark h2,.garrison-language h2{font-size:clamp(30px,3.5vw,46px);line-height:1.12;margin:18px 0 25px;letter-spacing:-.03em}.garrison-mark p:not(.eyebrow),.garrison-language p:not(.eyebrow){font-size:17px;line-height:1.7;color:#605c58;max-width:480px}.garrison-symbol{background:#3d071c;padding:45px;border-radius:12px}.garrison-symbol :global(img){width:100%;height:auto}.garrison-language{background:#e9e6e1;padding:65px 0}.garrison-language-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:90px;align-items:center}.garrison-language-grid :global(img){width:100%;height:auto;border-radius:12px}.garrison-apparel{padding-top:75px;max-width:1120px}.garrison-apparel :global(img){width:100%;height:auto;border-radius:12px}@media(max-width:760px){.garrison-logo{padding:45px 0 35px}.garrison-logo p{font-size:13px;margin-top:25px}.garrison-mark,.garrison-language-grid{grid-template-columns:1fr;gap:35px}.garrison-mark{padding-block:45px}.garrison-language{padding:35px 0}.garrison-language-grid> :global(img){order:2}.garrison-symbol{padding:30px}.garrison-apparel{padding-top:40px}}
</style>
