---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ScrollMotion from '../components/ScrollMotion.astro';
import { siteLink } from '../lib/links';
const projects = [
 {name:'The Villas',category:'Brand direction · Web · Photography · Social',image:'villas',alt:'The Villas senior care brand and outdoor patio',path:'/the-villas',number:'01'},
 {name:'Pillars',category:'Art direction · Packaging · Iconography',image:'pillars',alt:'Pillars coconut yogurt packaging in four colorful flavors',path:'/pillars-yogurt',number:'02'},
 {name:'Brand identities',category:'Distinctive logos. Lasting impressions.',image:'branding',animatedImage:'/images/brand-identities.gif',alt:'A selection from Zion Creative’s logo and identity work',path:'/logo-design-springfield-il',number:'03'},
 {name:'Beat',category:'Identity · Animation · Messaging · Collateral',image:'beat',alt:'Bold Beat brand identity on an outdoor billboard',path:'/bfg',number:'04'},
];
---
<BaseLayout title="Zion Creative | Springfield IL | Web Design and Marketing Services" description="Zion Creative is a Springfield, Illinois design studio creating thoughtful brands, custom websites, and ongoing creative support for businesses, agencies, and nonprofits.">
<Header />
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Independent creative studio · Springfield, IL</p>
      <h1 id="hero-title">We create <em>innovative</em><br class="desktop-break" /> design experiences<span class="lime-dot">.</span></h1>
      <div class="hero-bottom"><p>For brands, agencies, and nonprofits.<br />Thoughtful strategy. Distinctive design. Lasting impact.</p><a class="text-link" href="#selected-work">Explore our work <span aria-hidden="true"><Arrow direction="down" /></span></a></div>
    </div>
    <div class="work-strip" aria-label="A glimpse of our creative work">
      <div class="strip-card strip-one" data-parallax="-1"><img src="/images/packaging-640.webp" width="640" height="800" alt="Bold food packaging design" fetchpriority="high" /></div>
      <div class="strip-card strip-two" data-parallax="1"><picture><source media="(prefers-reduced-motion: reduce)" srcset="/images/mobile-sites-poster.webp" /><img src="/images/mobile-sites.gif" width="469" height="720" alt="Animated showcase of mobile websites designed by Zion Creative" decoding="async" /></picture></div>
      <div class="strip-card strip-three" data-parallax="-0.65"><img src="/images/pillars-hero-640.webp" width="640" height="800" alt="Colorful Pillars yogurt packaging" /></div>
      <div class="strip-card strip-four" data-parallax="1"><img src="/images/beer-640.webp" width="640" height="800" alt="Illustrated craft beer can designs" /></div>
      <div class="strip-card strip-five" data-parallax="-1"><img src="/images/website-640.webp" width="640" height="800" alt="A custom website displayed on a laptop" /></div>
    </div>
  </section>
  <section class="services section-dark" aria-labelledby="services-title">
    <div class="container services-grid">
      <div><p class="eyebrow">A creative partner, from the start.</p><h2 id="services-title">Big-picture thinking.<br />A love for the <em>details.</em></h2><p class="section-intro">From logos to animations, social content to website experiences, we love all things creative.</p></div>
      <div class="service-list">
        <a href={siteLink('/logo-design-springfield-il')}><span class="service-index">01</span><div><h3>Branding & design</h3><p>Build a brand that feels unmistakably you.</p></div><span aria-hidden="true"><Arrow /></span></a>
        <a href={siteLink('/web-design-springfield-il')}><span class="service-index">02</span><div><h3>Web design</h3><p>Thoughtful experiences, built for real people.</p></div><span aria-hidden="true"><Arrow /></span></a>
        <a href={siteLink('/brand-management-services')}><span class="service-index">03</span><div><h3>Ongoing creative</h3><p>A trusted partner as your business grows.</p></div><span aria-hidden="true"><Arrow /></span></a>
      </div>
    </div>
  </section>
  <section id="selected-work" class="selected-work section-dark" aria-labelledby="work-title">
    <div class="container"><div class="section-heading"><div><p class="eyebrow">A few things we’ve made</p><h2 id="work-title">Selected <em>work.</em></h2></div><a class="text-link" href={siteLink('/portfolio')}>View full portfolio <span aria-hidden="true"><Arrow /></span></a></div>
      <div class="projects-grid">{projects.map(project => <ProjectCard {...project} />)}</div>
    </div>
  </section>
  <section class="testimonial section-dark" aria-labelledby="quote-title"><div class="container quote-grid"><div><p class="eyebrow" id="quote-title">Good work. Good people.</p><span class="quote-mark" aria-hidden="true">“</span></div><div><blockquote>Nick at Zion Creative was impressive from the start. He captured our vision and brought it to life quickly. I highly recommend you go with Zion Creative to design your site.</blockquote><a class="text-link" href={siteLink('/testimonials')}>More kind words <span aria-hidden="true"><Arrow /></span></a></div></div></section>
  <section class="about-section" aria-labelledby="about-title"><div class="container about-grid"><div class="about-image"><img src="/images/nick-1280.webp" srcset="/images/nick-640.webp 640w, /images/nick-1280.webp 1280w" sizes="(max-width:760px) 100vw, 50vw" alt="Nick and Ellen from Zion Creative with their family" width="1280" height="960" loading="lazy" /></div><div class="about-copy"><p class="eyebrow">Small studio. Personal approach.</p><h2 id="about-title">Work hard.<br />Keep learning.<br /><em>Be nice to people.</em></h2><p>Founded by Nick and Ellen in 2017, Zion Creative brings close collaboration and a curious, hands-on approach to every project. Based in Springfield, Illinois, we partner with brands near and far.</p><a class="text-link" href={siteLink('/about-us')}>Get to know us <span aria-hidden="true"><Arrow /></span></a></div></div>
    <div class="container stats" aria-label="Zion Creative in numbers"><div><strong>355<span>+</span></strong><p>Projects completed</p></div><div><strong>225<span>+</span></strong><p>Organizations helped</p></div><div><strong>8<span>+</span></strong><p>Years in operation</p></div></div>
  </section>
  <section class="project-cta"><div class="container cta-inner"><p class="eyebrow">Your next chapter starts here.</p><div><h2>Let’s co-create<br /><em>something great.</em></h2><a class="circle-cta" href="/contact" aria-label="Start a project"><span aria-hidden="true"><Arrow /></span></a></div><p>For your brand. And what comes next.</p></div></section>
</main>
<Footer />
<ScrollMotion />
</BaseLayout>
