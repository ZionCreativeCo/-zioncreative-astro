---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import IndustrySections from '../components/IndustrySections.astro';
import '../styles/industry.css';
const features=[
 {icon:'strategy',title:'Practice areas with a clear purpose.',text:'Give each service its own page. Explain who you help, the issues your team handles, and what a prospective client can expect from an initial conversation.'},
 {icon:'branding',title:'People behind the practice.',text:'Attorney profiles bring together approved credentials, admissions, experience, and approachable photography. Make it easy to understand who a visitor would work with.'},
 {icon:'web',title:'A straightforward next step.',text:'Connect visitors with your existing intake process through click-to-call links, a brief inquiry form, or appointment scheduling. Keep the path clear on every screen.'},
 {icon:'campaign',title:'A local search foundation.',text:'Build relevant page titles, descriptions, internal links, and structured data around your actual practice areas and service locations. Align business information with your verified listings.'},
 {icon:'management',title:'An easier site to maintain.',text:'Organize attorney profiles, articles, and service pages so your team can keep information current. Choose a manageable platform or ongoing website care based on your workflow.'},
 {icon:'print',title:'Details that support trust.',text:'Readable typography, visible keyboard focus, descriptive image text, and clear navigation support a more accessible experience. Include your firm-approved notices and privacy information.'}
];
const faqs=[
 {q:'How much does a law firm website cost?',a:'Our Squarespace website packages start at $2,500. The final scope depends on the number of pages, attorney profiles, practice areas, and integrations. AI-built website hosting and care starts at $75 per month, with the agreed initial build included and no startup fee. We confirm deliverables and pricing before work begins.'},
 {q:'Do you work with law firms outside Springfield, Illinois?',a:'Yes. Zion Creative is based in Springfield, Illinois, and works remotely with firms elsewhere. Content and local search setup should reflect the locations your firm actually serves, rather than a list of cities added only for search traffic.'},
 {q:'Can you redesign our current website without losing important pages?',a:'We start by reviewing your current page structure, content, and available search data. The migration plan identifies pages to retain, URLs that need redirects, and metadata to carry forward. Search positions can change during a redesign; rankings are not guaranteed.'},
 {q:'Can our team update the website?',a:'Yes. A Squarespace build includes recorded training and post-launch support. We can also discuss Webflow or managed AI-built websites when the content and functionality call for a different approach.'},
 {q:'Can you add attorney profiles, reviews, or case results?',a:'Yes, when your firm supplies approved content and any required permissions. Your team reviews credentials, testimonials, results, disclaimers, and other advertising content before publication. Website design does not replace your firm’s review of applicable professional requirements.'},
 {q:'How do you handle inquiry forms?',a:'We connect a short inquiry form or your existing intake tool, with wording your firm approves. An initial inquiry should request only necessary contact details. Sensitive case documents and confidential information belong in the secure process selected by your firm.'}
];
const schema={'@context':'https://schema.org','@type':'Service',name:'Law Firm Website Design',serviceType:'Website design and development for law firms',description:'Custom law firm website design, development, and local search foundations from Zion Creative in Springfield, Illinois.',url:'https://www.zioncreative.co/law-firm-web-design/',provider:{'@type':'Organization',name:'Zion Creative',url:'https://www.zioncreative.co/'},areaServed:[{'@type':'City',name:'Springfield',containedInPlace:{'@type':'State',name:'Illinois'}},{'@type':'Country',name:'United States'}]};
---
<BaseLayout title="Law Firm Web Design in Springfield, IL | Zion Creative" description="Custom law firm website design in Springfield, Illinois. Practice-area pages, attorney profiles, mobile-friendly layouts, and local SEO foundations. Explore pricing.">
<Header/>
<main id="main">
<section class="law-hero section-dark"><div class="container law-hero-grid"><div class="law-copy"><p class="law-eyebrow">Law firm website design</p><h1>Law firm web design.<br/><em>Clear. Credible. Human.</em></h1><p>Your website should help people understand your practice and feel comfortable taking the next step. We design and develop websites that connect your firm’s expertise with the people looking for it.</p><div class="law-actions"><a class="button button-lime" href="/contact">Discuss your firm’s website</a><a class="text-link" href="/pricing/#websites">Explore website pricing</a></div><p class="law-location">Springfield, Illinois · Working with firms nationwide</p></div><div class="law-preview" aria-label="Illustrative law firm website layout"><div class="preview-bar" aria-hidden="true"><i></i><i></i><i></i></div><div class="preview-content"><div class="preview-nav"><span>YOUR FIRM</span><span>Practice · People · Contact</span></div><p class="preview-label">Illustrative website direction</p><h2>Sound guidance.<br/>A clear path forward.</h2><p>A place to understand your options,<br/>meet the team, and start a conversation.</p><span class="preview-cta">Contact the firm</span><div class="preview-bottom"><span>Practice areas</span><span>Meet your attorneys</span><span>Plan your first visit</span></div></div></div></div></section>
<section class="container law-intro"><h2>Built around how<br/><em>people choose counsel.</em></h2><div><p>Someone arriving at your website may be comparing firms, looking for a specific attorney, or trying to understand an unfamiliar situation. A useful law firm website answers the essentials: what you do, where you work, who is on your team, and how to reach you.</p><p>For firms in Springfield and Central Illinois, that means a clear local presence paired with content that reflects your real practice. We connect brand direction, thoughtful page structure, and website development into one consistent experience.</p></div></section>
<section class="law-features"><div class="container"><div class="law-heading"><h2>The right information.<br/><em>In the right places.</em></h2><p>Designed around your firm, your content, and your intake process.</p></div><div class="law-feature-grid">{features.map(feature=><article><span class="law-icon"><ServiceIcon kind={feature.icon}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div></div></section>
<section class="container law-local"><div><p class="eyebrow">Local relevance</p><h2>Law firm websites<br/><em>for Springfield, Illinois.</em></h2></div><div><p>We’re based in Springfield, with a practical understanding of how local businesses present themselves online. Your site can connect practice-area information with your office details, contact options, and the communities you genuinely serve.</p><p>Our SEO foundation focuses on useful content and a sound technical structure: readable pages, relevant metadata, accurate business details, mobile layouts, and intentional links between related topics. Ongoing content and search work can be scoped separately as your site grows.</p><a class="text-link" href="/digital-marketing-springfield-il">Explore digital marketing services</a></div></section>
<IndustrySections page={{audience:'law firms',steps:[{title:'Understand the practice',text:'Start with your services, audience, existing site, and the way inquiries reach your team.'},{title:'Plan the experience',text:'Organize the pages and develop a visual direction that reflects your firm’s identity.'},{title:'Build and review',text:'Develop responsive layouts and integrations, then review content and functionality with your team.'},{title:'Launch and hand over',text:'Connect the domain, check the key journeys, and provide training or a plan for ongoing care.'}],faqs}}/>
<ProjectCTA/>
</main><Footer/>
<script type="application/ld+json" set:html={JSON.stringify(schema)}/>
</BaseLayout>
<style>
.law-hero{padding-block:80px;overflow:hidden}.law-hero-grid{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:65px}.law-copy>.law-location{color:#aaa99f;font-size:12px;line-height:1.6;margin:25px 0 0}.law-copy>.law-eyebrow{color:#d4d0c6;font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:18px}.law-copy h1{font-size:clamp(42px,4.6vw,68px);line-height:1.12;letter-spacing:-.04em;margin-bottom:30px}.law-copy>p:not(.law-location):not(.law-eyebrow){color:#d4d0c6;font-size:18px;line-height:1.75;max-width:610px}.law-actions{display:flex;flex-wrap:wrap;align-items:center;gap:25px;margin-top:35px}.law-actions .text-link{font-size:14px}.law-preview{background:#f4f1e8;color:#27322a;border:1px solid #ffffff40;border-radius:12px;overflow:hidden;transform:rotate(-3deg);box-shadow:0 25px 55px #0003}.preview-bar{background:#dddcd1;display:flex;gap:5px;padding:12px 16px}.preview-bar i{width:5px;height:5px;border-radius:50%;background:#72776a}.preview-content{padding:25px 30px 0}.preview-nav{display:flex;justify-content:space-between;gap:15px;font-size:10px;border-bottom:1px solid #27322a30;padding-bottom:20px}.preview-nav>span:first-child{font-weight:700;letter-spacing:.12em}.preview-label{font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin:40px 0 20px}.preview-content h2{font-family:Georgia,serif;font-size:clamp(30px,3vw,44px);line-height:1.15;font-weight:400;letter-spacing:-.03em}.preview-content>p:not(.preview-label){font-size:12px;line-height:1.7;margin-top:22px}.preview-cta{display:inline-block;background:#27322a;color:#fff;padding:11px 17px;font-size:11px;margin-top:25px;border-radius:4px}.preview-bottom{display:flex;justify-content:space-between;gap:12px;font-size:10px;border-top:1px solid #27322a30;padding:25px 0;margin-top:45px}.law-intro,.law-local{display:grid;grid-template-columns:1fr 1.2fr;gap:70px;padding-block:80px}.law-intro h2,.law-local h2,.law-heading h2,.law-process h2,.law-faq h2{font-size:clamp(34px,4vw,54px);line-height:1.15}.law-intro p,.law-local p{font-size:17px;line-height:1.8;color:#59574f}.law-intro p+p,.law-local p+p{margin-top:20px}.law-local .text-link{margin-top:25px}.law-local h2{margin-top:20px}.law-features{padding-block:75px;background:#e6e4db}.law-heading{display:flex;justify-content:space-between;align-items:end;gap:35px;margin-bottom:40px}.law-heading>p{max-width:330px;color:#59574f}.law-feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.law-feature-grid article{padding:28px;background:#f8f7f3;border:1px solid #c1bfb4;border-radius:12px}.law-icon{display:flex;align-items:center;justify-content:center;width:46px;height:46px;background:var(--lime);border-radius:12px;margin-bottom:25px}.law-icon :global(svg){width:26px;height:26px}.law-feature-grid h3{font-size:25px;line-height:1.2;letter-spacing:-.03em;margin-bottom:20px}.law-feature-grid p{font-size:15px;line-height:1.75;color:#59574f}.law-process{padding-block:75px}.law-process-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px;margin-top:50px}.law-process-grid article{border-top:1px solid #696b5f;padding-top:25px}.law-process-grid span{color:var(--lime);font-size:13px}.law-process-grid h3{font-size:25px;line-height:1.2;margin:20px 0}.law-process-grid p{color:#d4d0c6;font-size:15px}.law-pricing{display:flex;align-items:center;justify-content:space-between;gap:45px;padding-block:65px;border-bottom:1px solid #bab7ab}.law-pricing h2{font-size:38px;margin-bottom:20px}.law-pricing p{max-width:700px;color:#59574f}.law-pricing .button{flex-shrink:0}.law-faq{display:grid;grid-template-columns:1fr 1.3fr;gap:70px;padding-block:80px}.law-faq details{border-top:1px solid #aaa79b}.law-faq details:last-child{border-bottom:1px solid #aaa79b}.law-faq summary{display:flex;justify-content:space-between;gap:20px;list-style:none;cursor:pointer;font-weight:550;padding-block:24px;font-size:17px}.law-faq summary::-webkit-details-marker{display:none}.law-faq summary span{font-size:24px;flex-shrink:0}.law-faq details[open] summary span{transform:rotate(45deg)}.law-faq details p{color:#59574f;font-size:16px;line-height:1.75;padding-bottom:25px}.law-links{padding-bottom:75px}.law-links h2{font-size:35px;margin-bottom:20px}.law-links p{color:#59574f}.law-links>div{display:flex;flex-wrap:wrap;gap:25px;margin-top:25px}@media(max-width:1000px){.law-hero-grid{gap:35px}.law-feature-grid{grid-template-columns:1fr 1fr}.law-process-grid{grid-template-columns:1fr 1fr}.law-pricing{align-items:start;flex-direction:column}}@media(max-width:760px){.law-hero{padding-block:40px 55px}.law-hero-grid,.law-intro,.law-local,.law-faq{grid-template-columns:1fr;gap:35px}.law-copy h1{font-size:43px}.law-copy>p:not(.law-location):not(.law-eyebrow){font-size:17px}.law-preview{margin:15px 6px 0;transform:rotate(-2deg)}.preview-content{padding:25px 22px 0}.preview-nav{font-size:9px}.preview-content h2{font-size:35px}.preview-bottom{font-size:9px;gap:8px}.law-intro,.law-local,.law-faq{padding-block:45px}.law-features,.law-process{padding-block:45px}.law-heading{display:block}.law-heading>p{margin-top:22px}.law-feature-grid,.law-process-grid{grid-template-columns:1fr}.law-pricing{padding-block:45px;gap:25px}.law-links{padding-bottom:45px}.law-location{font-size:12px}}
</style>
