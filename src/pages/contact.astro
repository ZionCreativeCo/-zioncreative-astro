---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout title="Start a Project — Zion Creative" description="Tell Zion Creative about your next branding, website, or creative project. Based in Springfield, Illinois, collaborating everywhere.">
<Header />
<main id="main" class="contact-main container"><p class="eyebrow">A little hello can lead to something great.</p><h1>Let’s work<br /><em>together.</em></h1><div class="contact-grid"><div><p>Have a project in mind? Tell us a little about your brand, where you want to go, and how we can help.</p><p>Prefer a conversation?</p><a class="text-link" href="mailto:hello@zioncreative.co">hello@zioncreative.co <span aria-hidden="true"><Arrow /></span></a><p><a href="tel:+12177252031">217.725.2031</a></p></div><div class="contact-widget"><ContactForm /><noscript><p>Please enable JavaScript to use the form, or email <a href="mailto:hello@zioncreative.co">hello@zioncreative.co</a>.</p></noscript></div></div></main>
<Footer />
</BaseLayout>
