---
import Arrow from '../components/Arrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout title="Start a Project, Zion Creative" description="Tell Zion Creative about your next branding, website, or creative project. Based in Springfield, Illinois, collaborating everywhere.">
<Header />
<main id="main" class="contact-main container"><div class="contact-grid"><div class="contact-copy"><p class="eyebrow">A little hello can lead to something great.</p><h1>Let’s work<br /><em>together.</em></h1><p class="contact-intro">Have a project in mind? Tell us a little about your brand, where you want to go, and how we can help.</p><p>Prefer a conversation?</p><a class="text-link" href="mailto:hello@zioncreative.co">hello@zioncreative.co <span aria-hidden="true"><Arrow /></span></a><p><a href="tel:+12177252031">217.725.2031</a></p></div><div class="contact-widget"><ContactForm /><noscript><p>Please enable JavaScript to use the form, or email <a href="mailto:hello@zioncreative.co">hello@zioncreative.co</a>.</p></noscript></div></div></main>
<Footer />
</BaseLayout>

<style>
.contact-main .contact-grid{margin-top:0;align-items:center}.contact-copy h1{font-size:clamp(52px,5.7vw,82px);margin:25px 0 36px}.contact-copy .eyebrow{margin-bottom:0}.contact-main .contact-widget{min-height:0;padding-top:0;margin-top:0}.contact-copy>p:last-child{margin-bottom:0}.contact-copy .contact-intro{max-width:420px}@media(max-width:760px){.contact-main .contact-grid{gap:35px;align-items:start}.contact-copy h1{font-size:65px}}
</style>
