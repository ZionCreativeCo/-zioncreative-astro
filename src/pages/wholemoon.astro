---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import CaseTemplate from '../components/CaseTemplate.astro';
import ScrollableScreen from '../components/ScrollableScreen.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import screens from '../data/wholemoon-screens.json';
import '../styles/secondary.css';
---
<BaseLayout title="WholeMoon Shopify Development | Zion Creative" description="Shopify development for WholeMoon, in partnership with Colossus, with additional design assistance for a plant-based beverage website."><Header/><main id="main"><CaseTemplate name="WholeMoon" tagline="A fresh brand. Brought to life on Shopify." related={['/colossus','/project/vpne','/pillars-yogurt']}>
<div slot="hero" class="wholemoon-stage"><div class="container"><ScrollableScreen image={screens.home} brand="WholeMoon" title="Homepage" address="WholeMoon / Homepage" primary/></div></div>
<section class="container clean-story-section wholemoon-intro"><p class="eyebrow">The partnership</p><div class="clean-story-copy"><h2>From brand vision<br/>to a custom Shopify experience.</h2><p>Whole Moon is a startup beverage company making a splash in the plant-based space. Its distinctive ingredients and roasting process called for a clear, engaging digital introduction.</p><p>In partnership with Colossus, Zion Creative’s primary role was Shopify development, bringing the brand vision to life in a custom website. We also provided design assistance along the way.</p></div><div class="clean-case-credits wholemoon-credits"><div><strong>Primary role</strong>Shopify development</div><div><strong>Additional support</strong>Design assistance</div><div><strong>Agency</strong>Colossus</div><div><strong>Project</strong>Food & beverage · Q4 2023</div></div></section>
<section class="container clean-story-section"><p class="eyebrow">Shopify development</p><div class="clean-story-copy"><h2>A colorful experience.<br/>A connected product story.</h2><p>The homepage brings together the product range, the brand story, and the ingredients that set WholeMoon apart. Development translates the visual direction into a consistent experience across the site.</p></div></section>
<div class="wholemoon-stage"><div class="container wholemoon-screens"><ScrollableScreen image={screens.products} brand="WholeMoon" title="Our Products" address="WholeMoon / Our Products"/><ScrollableScreen image={screens.coconut} brand="WholeMoon" title="Coconut" address="WholeMoon / Coconut"/></div></div>
<section class="clean-impact"><div class="container clean-impact-inner"><div class="wholemoon-outcomes"><p><strong>Custom Shopify development</strong>The primary contribution to the project.</p><p><strong>Design assistance</strong>Additional support alongside the agency’s brand direction.</p><p><strong>A connected website</strong>Homepage, product range, and individual product experiences.</p></div><div class="clean-impact-copy"><p class="eyebrow">The result</p><h2>A digital home<br/>for a brand on the rise.</h2><p>The Shopify website brings WholeMoon’s brand and product story together, giving visitors a clear way to discover the range and explore what makes each flavor distinct.</p></div></div></section>
</CaseTemplate><ProjectCTA/></main><Footer/></BaseLayout>
<style>
.wholemoon-stage{background:#e5e1d9;padding:55px 0}.wholemoon-intro{row-gap:30px}.wholemoon-credits{grid-column:2;margin-top:0;gap:20px 30px}.wholemoon-screens,.wholemoon-content{display:grid;grid-template-columns:1fr 1fr;gap:35px}.wholemoon-content h3{font-size:19px;margin-bottom:14px;font-weight:500}.wholemoon-outcomes{display:grid;gap:25px}.wholemoon-outcomes p{font-size:14px;line-height:1.5;color:#66635d}.wholemoon-outcomes strong{display:block;font-size:24px;color:var(--ink);margin-bottom:8px;font-weight:500}@media(max-width:760px){.wholemoon-stage{padding:30px 0}.wholemoon-credits{grid-column:1}.wholemoon-screens,.wholemoon-content{grid-template-columns:1fr;gap:35px}}
</style>
