---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import CaseImage from '../components/CaseImage.astro';
import CaseTemplate from '../components/CaseTemplate.astro';
import CaseFilm from '../components/CaseFilm.astro';
import ExpandingGallery from '../components/ExpandingGallery.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import content from '../data/villas.json';
import '../styles/secondary.css';
---
<BaseLayout title={content.title} description="Explore Zion Creative’s work for The Villas Senior Care Community in central Illinois, from website design and brand management to social media and photography.">
<Header/><main id="main">
<CaseTemplate name="The Villas" tagline="Thoughtful design. Meaningful connection." related={['/colossus','/evangel','/project/kp']}>
<CaseFilm slot="hero" name="villas-home-scroll" label="Scrolling presentation of the redesigned Villas homepage" src="/videos/villas-home-scroll.mp4" poster="/images/villas-home-scroll-poster.jpg" width={1280} height={720} address="villasseniorcare.com"/>
<section class="container clean-story-section villas-intro" aria-labelledby="partnership-title"><p class="eyebrow">The partnership</p><div class="clean-story-copy"><h2 id="partnership-title">A community built on care.<br/>A brand built on connection.</h2><p>{content.intro}</p></div><div class="clean-case-credits villas-credits"><div><strong>Client</strong>The Villas Senior Care Community</div><div><strong>Our role</strong>{content.roles.join(' · ')}</div><a class="text-link credits-live-link" href="https://www.villasseniorcare.com/" target="_blank" rel="noopener noreferrer">Explore the live site <Arrow/></a></div></section>
<section class="container clean-story-section" aria-labelledby="website-title"><p class="eyebrow">Website</p><div class="clean-story-copy"><h2 id="website-title">A clearer path to care.</h2><p>{content.problem}</p><p>{content.solution}</p></div></section>
<div class="container villas-comparison"><figure><figcaption><span>Before</span>Separate experiences</figcaption><div class="screen-frame"><div class="screen-top"><i></i><i></i><i></i></div><CaseImage name="villas-detail-03" alt="Before: the previous Villas website with separate community navigation"/></div></figure><figure><figcaption><span>After</span>A unified presence</figcaption><div class="screen-frame"><div class="screen-top"><i></i><i></i><i></i></div><CaseImage name="villas-detail-04" alt="After: redesigned Villas website with clear senior living and memory care navigation"/></div></figure></div>
<section class="villas-web-detail" aria-label="Independent living website design"><div class="container detail-layout"><div class="detail-copy"><p class="eyebrow">Every page, connected</p><h2>One experience.<br/>Many ways to feel at home.</h2><p>A consistent visual language connects the care options, community information, and next steps, giving families a clear place to start.</p></div><div class="detail-screen screen-frame"><div class="screen-top"><i></i><i></i><i></i><span>Independent living</span></div><div class="website-scroll" tabindex="0" role="region" aria-label="Independent living page preview. Scroll to explore the full design."><CaseImage name="villas-detail-07" alt="Full redesigned Villas independent living page, including amenities, care information, and contact details"/></div></div></div></section>
<section class="container clean-story-section" aria-labelledby="social-title"><p class="eyebrow">Social media</p><div class="clean-story-copy"><h2 id="social-title">A community worth sharing.</h2><p>{content.social}</p></div></section>
<figure class="villas-social"><div class="container"><CaseImage name="villas-detail-08" alt="Three original social media designs for The Villas: a birthday celebration, community information, and employee recognition" sizes="100vw"/></div></figure>
<section class="container clean-story-section" aria-labelledby="photography-title"><p class="eyebrow">Photography</p><div class="clean-story-copy"><h2 id="photography-title">The people. The place.<br/>The feeling of home.</h2><p>A closer look at the spaces and people that make The Villas a community.</p><p class="gallery-hint">Swipe through photos on mobile, or hover to expand on desktop. Use the arrow keys to move between images.</p></div></section>
<div class="container"><ExpandingGallery/></div>
<section class="clean-impact" aria-labelledby="impact-title"><div class="container clean-impact-inner"><div class="clean-impact-facts">{content.results.map(result=><p><strong>{result.value}</strong>{result.label}</p>)}</div><div class="clean-impact-copy"><p class="eyebrow">Impact</p><h2 id="impact-title">A stronger presence.<br/>A clearer connection.</h2><p>The website, social creative, photography, and advertising work together to make The Villas easier to discover and more approachable for seniors and their families.</p></div></div></section>
<section class="container clean-story-section villas-testimonial" aria-label="Client testimonial"><p class="eyebrow">In their words</p><div><blockquote>“{content.quote}”</blockquote><p class="attribution">{content.quoteAttribution}</p></div></section>
</CaseTemplate><ProjectCTA/></main><Footer/>
</BaseLayout>
<style>
.villas-intro{row-gap:30px}.villas-credits{grid-column:2;margin-top:0;gap:20px 30px;align-items:center}.villas-credits>div:nth-child(2){max-width:350px}.credits-live-link{margin-left:auto;white-space:nowrap;font-size:14px}.villas-comparison{display:grid;grid-template-columns:1fr 1fr;gap:35px;padding-bottom:75px}.villas-comparison figure{margin:0}.villas-comparison figcaption{display:flex;gap:15px;align-items:center;font-size:13px;color:#6d695f;margin-bottom:18px}.villas-comparison figcaption span{color:var(--ink);font-weight:600}.screen-frame{border:1px solid #bfbdb3;border-radius:10px;overflow:hidden;background:#eeefea;box-shadow:0 20px 45px #25231b18}.screen-frame img{width:100%;height:auto;display:block}.screen-top{display:flex;gap:5px;padding:13px 16px;align-items:center;background:#eeefea}.screen-top i{width:5px;height:5px;border-radius:50%;background:#85867e}.screen-top span{margin:auto;font-size:11px;color:#67685f}.villas-web-detail{background:#e6e2d8;padding:75px 0}.detail-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;align-items:center}.detail-copy h2{font-size:clamp(28px,3vw,42px);line-height:1.15;letter-spacing:-.03em;margin:20px 0}.detail-copy p:not(.eyebrow){color:#55534d;font-size:17px;line-height:1.7}.website-scroll{height:530px;overflow-y:auto}.website-scroll:focus-visible{outline:3px solid var(--lime);outline-offset:-3px}.villas-social{margin:0;background:#eae7e1;padding:25px 0}.villas-social img{width:100%;height:auto;display:block}.clean-story-copy .gallery-hint{font-size:13px;color:#777267;margin-top:18px}.villas-testimonial blockquote{font-size:clamp(22px,2.3vw,31px);line-height:1.5;letter-spacing:-.025em;margin:0;max-width:880px}.attribution{font-size:13px;margin-top:25px;color:#68665f}@media(max-width:1000px){.credits-live-link{margin-left:0}.detail-layout{gap:40px}.website-scroll{height:420px}}@media(max-width:760px){.villas-credits{grid-column:1}.villas-comparison{grid-template-columns:1fr;gap:35px;padding-bottom:45px}.villas-web-detail{padding-block:45px}.detail-layout{grid-template-columns:1fr;gap:30px}.website-scroll{height:400px}.villas-social{padding:15px 0}.villas-credits>div:nth-child(2){max-width:none}}
</style>
