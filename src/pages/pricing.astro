---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
const branding = [
 {name:'Logo Essentials',price:'500',intro:'A focused logo package for a new idea or small business ready to take its first step.',features:['One initial logo direction','Two revision rounds','Primary logo design','Core color palette and type recommendations','Final SVG, PDF, and transparent PNG files']},
 {name:'Brand Identity',price:'1,000',intro:'A coordinated identity with the flexibility to show up consistently across your everyday touchpoints.',features:['Two initial creative directions','Three revision rounds','Primary logo, secondary logo, and submark','Brand color palette and typography system','Concise brand guide','Social profile image','Final SVG, PDF, and transparent PNG files']},
 {name:'Brand Toolkit',price:'1,750',intro:'An identity and practical launch materials to help your business put its new look to work.',features:['Three initial creative directions','Three revision rounds','Primary logo, secondary logo, and submark','Brand color palette and typography system','Detailed brand guidelines','Business card design for up to three people','Social profile and cover graphics','Three reusable social post templates','Final SVG, PDF, and transparent PNG files']}
];
const websites = [
 {name:'Starter',price:'2,500',intro:'A compact website that makes your business easy to understand and gives visitors a clear next step.',features:['A site of up to 4 pages','Layouts for desktop, tablet, and mobile','Two feedback and revision cycles','Recorded website training','2–5 week delivery window','Email help for 30 days after launch']},
 {name:'Professional',price:'3,500',intro:'More space for your story, services, and work, with a thoughtful foundation for search.',features:['A site of up to 7 pages','Layouts for desktop, tablet, and mobile','Three feedback and revision cycles','Basic SEO: titles, descriptions, and tags','Recorded website training','2–5 week delivery window','Email help for 30 days after launch']},
 {name:'Advanced',price:'5,000',intro:'A more expansive Squarespace experience with custom functionality and room for a bigger vision.',features:['No page-count limit','Layouts for desktop, tablet, and mobile','Unlimited revision cycles','Unlimited custom code and features','Advanced search optimization','Recorded website training','4–8 week delivery window','Email help for 30 days after launch']}
];
const aiPlans = [
 {name:'Care',price:'75',intro:'Keep your AI-built website running smoothly, with the technical details handled.',features:['Managed hosting, publishing, and SSL','Site backups and availability checks','Bug fixes and a queued request workflow','Initial SEO and AI search setup','Email support within two business days']},
 {name:'Grow',price:'150',intro:'Ongoing improvements that help your website stay useful and discoverable.',features:['All Care services','Monthly SEO improvements','Monthly AI search refinements','Prioritized updates','A monthly report of completed work']},
 {name:'Scale',price:'225',intro:'A steady rhythm of new content and features, guided by your business goals.',features:['All Grow services','One new search-focused page or feature each month','An ongoing search ranking campaign','Priority scheduling within the week','A strategy conversation each quarter']}
];
---
<BaseLayout title="Branding & Website Pricing | Zion Creative" description="Explore Zion Creative’s branding packages from $500 to $1,750 and custom Squarespace website packages from $2,500. AI website hosting and care from $75/month. Based in Springfield, Illinois, working with brands everywhere.">
<Header/>
<main id="main">
 <section class="container pricing-hero">
  <h1>A clear starting point<br/><em>for your next chapter.</em></h1>
  <div class="pricing-intro"><p>Thoughtful design, a personal process, and a package that fits where you are. Explore the options, then let’s talk about what your project needs.</p><p class="pricing-location">Based in Springfield, Illinois.<br/>Creating for brands everywhere.</p></div>
  <nav class="pricing-jump" aria-label="Jump to pricing section"><a href="#branding">Branding packages <Arrow direction="down"/></a><a href="#websites">Website packages <Arrow direction="down"/></a></nav>
 </section>
 <section id="branding" class="container pricing-section" aria-labelledby="branding-title">
  <div class="pricing-section-heading"><div><p class="eyebrow">01 / Build your identity</p><h2 id="branding-title">Branding with<br/><em>your business in mind.</em></h2></div><p>From a single mark to a coordinated brand toolkit. Each package develops one selected creative direction into your final identity.</p></div>
  <div class="pricing-grid">{branding.map((plan,index)=><article class:list={['price-card',{'brand-featured':index===1}]} aria-labelledby={`brand-${index}`}><div class="plan-top"><span class="plan-number">0{index+1}</span><span>Branding</span></div><h3 id={`brand-${index}`}>{plan.name}</h3><p class="plan-price"><span class="currency">$</span>{plan.price}</p><p class="plan-billing">One-time project fee · USD</p><p class="plan-description">{plan.intro}</p><ul>{plan.features.map(feature=><li><span aria-hidden="true">✓</span>{feature}</li>)}</ul><a class="plan-cta" href="/contact">Discuss {plan.name} <Arrow/></a></article>)}</div>
  <p class="pricing-note">Design fees cover the deliverables listed above. Printing, paid fonts, stock assets, and additional collateral are quoted separately when needed. We’ll confirm your scope and schedule before work begins.</p>
 </section>
 <section id="websites" class="website-pricing" aria-labelledby="websites-title"><div class="container pricing-section">
  <div class="pricing-section-heading"><div><p class="eyebrow">02 / Build your digital home</p><h2 id="websites-title">A website that<br/><em>feels like you.</em></h2></div><p>Choose a custom Squarespace build you can manage yourself, or monthly hosting and care for an AI-built website.</p></div>
  <div class="website-plan-toggle" role="group" aria-label="Website pricing options" hidden><button type="button" data-pricing-option="squarespace" aria-pressed="true" aria-controls="squarespace-plans">Squarespace builds</button><button type="button" data-pricing-option="ai" aria-pressed="false" aria-controls="ai-plans">AI built &amp; hosting</button></div>
  <div id="squarespace-plans" data-pricing-panel="squarespace">
  <div class="pricing-grid">{websites.map((plan,index)=><article class="price-card website-card" aria-labelledby={`web-${index}`}><div class="plan-top"><span class="plan-number">0{index+1}</span><span>Squarespace</span></div><h3 id={`web-${index}`}>{plan.name}</h3><p class="plan-price"><span class="currency">$</span>{plan.price}</p><p class="plan-billing">One-time project fee · USD</p><p class="plan-description">{plan.intro}</p><ul>{plan.features.map(feature=><li><span aria-hidden="true">✓</span>{feature}</li>)}</ul><a class="plan-cta" href="/contact">Discuss {plan.name} <Arrow/></a></article>)}</div>
  <aside class="custom-package"><div><p class="eyebrow">Something more involved?</p><h3>A custom fit.</h3><p>For ecommerce, memberships, and complex builds: Advanced deliverables plus a tailored scope. We’ll discuss the requirements and provide a fixed project quote.</p></div><a class="button button-lime" href="/consultation">Discuss a custom website <Arrow/></a></aside>
  <div class="build-inclusions"><h3>With every website</h3><p>Supplied-content formatting, domain and SSL configuration, search-ready page metadata and image descriptions, Google Analytics and Squarespace analytics setup, video handover, and post-launch support.</p></div>
  <p class="pricing-note">Delivery windows begin at kickoff and depend on receiving content and feedback. Squarespace subscriptions, domains, and any paid third-party tools are separate. Analytics setup includes reviewing the privacy choices appropriate to your site.</p>
  </div>
  <div id="ai-plans" data-pricing-panel="ai">
   <div class="ai-plan-intro"><h3>AI built. Personally managed.</h3><p>Already have an AI-built website? We can take care of hosting and ongoing improvements. Need a new site? We’ll quote the initial build separately, then pair it with the right monthly plan.</p></div>
   <div class="pricing-grid">{aiPlans.map((plan,index)=><article class="price-card website-card" aria-labelledby={`ai-${index}`}><div class="plan-top"><span class="plan-number">0{index+1}</span><span>AI website care</span></div><h3 id={`ai-${index}`}>{plan.name}</h3><p class="plan-price"><span class="currency">$</span>{plan.price}<span class="monthly-unit">/mo</span></p><p class="plan-billing">Monthly plan · USD</p><p class="plan-description">{plan.intro}</p><ul>{plan.features.map(feature=><li><span aria-hidden="true">✓</span>{feature}</li>)}</ul><a class="plan-cta" href="/contact">Discuss {plan.name} <Arrow/></a></article>)}</div>
   <p class="pricing-note">Hosting is included. Initial builds, domains, paid tools, and larger development projects are quoted separately. Submit requests as needed; we complete them in order within the agreed scope. Response times are business-day targets. We’ll review your existing site and confirm scope, billing, and cancellation terms before you start. Search visibility and rankings are not guaranteed.</p>
  </div>
 </div></section>
 <section class="container pricing-questions" aria-labelledby="pricing-questions-title"><div><p class="eyebrow">Before we get started</p><h2 id="pricing-questions-title">Good questions.<br/><em>Clear answers.</em></h2></div><div class="pricing-faqs">
  <details><summary>Can we combine branding and a website?<span aria-hidden="true">+</span></summary><p>Absolutely. We can plan the identity and website together so the visual direction carries through from your logo to your digital experience. We’ll put the combined scope and pricing in your proposal.</p></details>
  <details><summary>What do I need to provide?<span aria-hidden="true">+</span></summary><p>Your goals, examples of what you like, and feedback along the way. Website projects also need page content, images, and access to the relevant accounts. If you need help creating content, we can discuss it as part of the scope.</p></details>
  <details><summary>How do revisions work?<span aria-hidden="true">+</span></summary><p>A revision round is a consolidated set of feedback on the presented work. Branding packages include the listed number of rounds on one selected direction. Website revision allowances are listed in each package. Deliverables and the review process are confirmed in your project agreement.</p></details>
  <details><summary>What about ongoing website support?<span aria-hidden="true">+</span></summary><p>Squarespace builds include 30 days of email support after launch. AI website plans include managed hosting and ongoing support at the selected monthly tier. If you’d like help beyond that, explore our <a href="/brand-management-services">ongoing management services</a>.</p></details>
  <details><summary>How are payments and cancellations handled?<span aria-hidden="true">+</span></summary><p>Payment schedules and cancellation terms are set out in your project proposal or agreement. Review those details before committing. You can also read our <a href="/refunds">cancellation and refund information</a>.</p></details>
 </div></section>
 <section class="pricing-close"><div class="container"><p class="eyebrow">Let’s find the right fit</p><h2>What are you<br/><em>ready to build?</em></h2><a class="button" href="/contact">Tell us about your project <Arrow/></a></div></section>
</main><Footer/>
</BaseLayout>
<style>
.pricing-hero{padding-block:70px 55px}.pricing-hero h1{font-size:clamp(45px,6.5vw,88px);margin-top:0;max-width:1100px}.pricing-intro{display:flex;justify-content:space-between;gap:60px;margin-top:32px}.pricing-intro>p:first-child{max-width:640px;font-size:19px;color:#55534d}.pricing-location{font-size:14px;align-self:end;color:#55534d}.pricing-jump{display:flex;gap:14px;margin-top:38px;flex-wrap:wrap}.pricing-jump a{display:flex;align-items:center;justify-content:space-between;gap:35px;min-height:52px;padding:12px 20px;border:1px solid #64645b;border-radius:6px;font-size:16px;font-weight:600}.pricing-jump a:hover{background:var(--lime)}.pricing-jump :global(svg){width:22px;height:22px}.pricing-section{padding-block:75px;scroll-margin-top:25px}#branding,#websites{scroll-margin-top:25px}.pricing-section-heading{display:grid;grid-template-columns:1.2fr 1fr;align-items:end;gap:60px;margin-bottom:40px}.pricing-section-heading h2{font-size:clamp(34px,4vw,57px);margin-top:20px}.pricing-section-heading>p{font-size:17px;max-width:450px;color:#55534d}.pricing-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.price-card{display:flex;flex-direction:column;padding:30px;background:#f8f7f3;border:1px solid #b8b5aa;border-radius:12px;min-width:0}.brand-featured{background:#d8df8d;border-color:#6c752e}.plan-top{display:flex;justify-content:space-between;font-size:12px;letter-spacing:.04em;color:#54554c;margin-bottom:32px}.plan-number{font-weight:600}.price-card h3{font-size:29px;letter-spacing:-.035em}.plan-price{font-size:clamp(42px,4.5vw,62px);line-height:1.1;letter-spacing:-.05em;margin-top:25px;font-weight:500;font-variant-numeric:lining-nums}.currency{font-size:.6em;vertical-align:top;line-height:1.4;margin-right:3px}.plan-billing{font-size:12px;color:#55564c;margin-top:9px}.plan-description{font-size:15px;line-height:1.65;margin-top:25px;min-height:100px}.price-card ul{list-style:none;padding:23px 0 30px;margin:24px 0 0;border-top:1px solid #8b8d7655;display:grid;gap:14px}.price-card li{display:flex;gap:12px;font-size:15px;line-height:1.5}.price-card li>span{flex-shrink:0;font-weight:700}.plan-cta{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px;padding:13px 15px;border:1px solid #252525;border-radius:5px;font-size:14px;font-weight:600;background:#252525;color:#f8f7f3}.plan-cta :global(svg){width:23px;flex-shrink:0}.plan-cta:hover{background:#45463a}.pricing-note{font-size:14px;line-height:1.7;color:#55534d;margin-top:26px;max-width:950px}.website-pricing{background:#252525;color:#f2ece7}.website-pricing h2 em{color:var(--lime)}.website-pricing .pricing-section-heading>p,.website-pricing .pricing-note{color:#cecec5}.website-card{background:#30312d;border-color:#66685c}.website-card .plan-top,.website-card .plan-billing{color:#d0d1c4}.website-card .plan-price{color:#d6df79}.website-card ul{border-top-color:#77786a}.website-card .plan-cta{background:#c4cf4b;color:#252525;border-color:#c4cf4b}.website-card .plan-cta:hover{background:#d6df79}.custom-package{display:flex;justify-content:space-between;align-items:center;gap:40px;padding:35px;border:1px solid #66685c;border-radius:12px;margin-top:25px}.custom-package h3{font-size:34px;margin:12px 0}.custom-package p:not(.eyebrow){font-size:16px;color:#cecec5;max-width:650px}.custom-package .button{flex-shrink:0}.build-inclusions{display:grid;grid-template-columns:1fr 2fr;gap:40px;margin-top:45px}.build-inclusions h3{font-size:25px}.build-inclusions p{color:#cecec5;font-size:16px}.pricing-questions{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px;padding-block:95px}.pricing-questions h2{font-size:clamp(34px,4vw,55px);margin-top:20px}.pricing-faqs details{border-top:1px solid #aaa79b}.pricing-faqs details:last-child{border-bottom:1px solid #aaa79b}.pricing-faqs summary{cursor:pointer;display:flex;justify-content:space-between;gap:24px;list-style:none;font-size:18px;font-weight:550;padding-block:24px}.pricing-faqs summary::-webkit-details-marker{display:none}.pricing-faqs summary span{font-size:24px;line-height:1}.pricing-faqs details[open] summary span{transform:rotate(45deg)}.pricing-faqs details p{font-size:16px;color:#55534d;padding-bottom:26px}.pricing-faqs a{text-decoration:underline;text-underline-offset:4px}.pricing-close{background:var(--lime);padding-block:70px}.pricing-close h2{font-size:clamp(47px,6.5vw,85px);margin-block:24px 32px}.pricing-close .button{background:#252525;color:#f8f7f3}.pricing-close .button:hover{background:#45463a}@media(max-width:1100px){.price-card{padding:24px}.pricing-grid{gap:16px}.custom-package{align-items:start;flex-direction:column}.plan-description{min-height:125px}}@media(max-width:760px){.pricing-hero{padding-block:40px 20px}.pricing-intro{display:block}.pricing-intro>p:first-child{font-size:17px}.pricing-location{margin-top:22px}.pricing-jump{display:grid;grid-template-columns:1fr;margin-top:28px}.pricing-jump a{gap:18px}.pricing-section{padding-block:45px}.pricing-section-heading{grid-template-columns:1fr;gap:24px;margin-bottom:28px}.pricing-grid{grid-template-columns:1fr;gap:20px}.price-card{padding:28px}.plan-description{min-height:0}.plan-top{margin-bottom:25px}.plan-price{font-size:58px}.custom-package{padding:28px;gap:25px}.custom-package .button{white-space:normal}.build-inclusions{grid-template-columns:1fr;gap:20px;margin-top:35px}.pricing-questions{grid-template-columns:1fr;gap:35px;padding-block:55px}.pricing-close{padding-block:50px}}
</style>

<script>
const toggle=document.querySelector<HTMLElement>('.website-plan-toggle');
if(toggle){
 const buttons=[...toggle.querySelectorAll<HTMLButtonElement>('[data-pricing-option]')];
 const panels=[...document.querySelectorAll<HTMLElement>('[data-pricing-panel]')];
 function select(option:string){buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.pricingOption===option)));panels.forEach(panel=>panel.hidden=panel.dataset.pricingPanel!==option);}
 select('squarespace');toggle.hidden=false;
 buttons.forEach(button=>button.addEventListener('click',()=>select(button.dataset.pricingOption!)));
}
</script>
<style>
.website-plan-toggle{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:32px}.website-plan-toggle[hidden],[data-pricing-panel][hidden]{display:none}.website-plan-toggle button{line-height:1.4;font-family:inherit;font-size:15px;font-weight:600;border:1px solid #858777;border-radius:30px;background:transparent;color:#f2ece7;padding:13px 22px;min-height:48px;cursor:pointer;touch-action:manipulation}.website-plan-toggle button[aria-pressed="true"]{background:var(--lime);color:#252525;border-color:var(--lime)}.monthly-unit{font-size:20px;letter-spacing:0;margin-left:5px}.ai-plan-intro{max-width:750px;margin-bottom:32px}.ai-plan-intro h3{font-size:30px;margin-bottom:16px}.ai-plan-intro p{font-size:17px;color:#cecec5}@media(max-width:760px){.website-plan-toggle{display:grid;grid-template-columns:1fr 1fr;gap:8px}.website-plan-toggle button{padding:12px 10px;font-size:13px}}
</style>
