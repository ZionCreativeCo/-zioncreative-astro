---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CaseTemplate from '../components/CaseTemplate.astro';
import ScrollableScreen from '../components/ScrollableScreen.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import pages from '../data/pages.json';
import '../styles/secondary.css';
const page=pages.find(p=>p.slug==='evangel')!;
---
<BaseLayout title={page.title} description={page.description.trim()}><Header/><main id="main"><CaseTemplate name="Evangel Church" tagline="A welcoming community. A bold digital home." related={['/project/vpne','/project/kp','/colossus']}>
<div slot="hero" class="evangel-hero"><div class="container"><ScrollableScreen id="3d77c50462b3" title="Homepage" address="Evangel Church" brand="Evangel Church" primary/></div></div>
<section class="container clean-story-section evangel-intro"><p class="eyebrow">The partnership</p><div class="clean-story-copy"><h2>A voice of hope.<br/>A place to belong.</h2><p>{page.paragraphs[0]}</p></div><div class="clean-case-credits evangel-credits"><div><strong>Our role</strong>Squarespace website</div><div><strong>Project</strong>Non-Profit / Church · Q4 2023</div></div></section>
<section class="container clean-story-section"><p class="eyebrow">The experience</p><div class="clean-story-copy"><h2>Welcome home.<br/>Find your next step.</h2><p>Bold typography, mint accents, and photography from the church bring energy and warmth to the homepage. Service information, community groups, and upcoming events give both first-time visitors and members clear places to begin.</p></div></section>
<div class="evangel-secondary"><div class="container evangel-about-grid"><div class="evangel-about-copy"><p class="eyebrow">About Evangel</p><h2>A community story,<br/>with room for everyone.</h2><p>The About page introduces the church’s mission, ministries, values, and beliefs. Distinct sections and a mix of photography and text make a longer page easy to explore.</p><p>Scroll through the screen to see how the full story comes together.</p></div><ScrollableScreen id="eca8f587019a" title="About Evangel" address="Evangel Church / About" brand="Evangel Church"/></div></div>
<section class="clean-impact"><div class="container clean-impact-inner"><div class="evangel-outcomes"><p><strong>Built on Squarespace</strong>A practical platform for the church’s website.</p><p><strong>Clear next steps</strong>Paths to service times, groups, events, and visiting.</p><p><strong>A welcoming identity</strong>A lively visual experience grounded in the community.</p></div><div class="clean-impact-copy"><p class="eyebrow">The result</p><h2>Creative and bold.<br/>Easy to find your place.</h2><p>The website brings Evangel’s community and mission into a cohesive digital experience, balancing expressive design with straightforward navigation for members and visitors.</p></div></div></section>
</CaseTemplate><ProjectCTA/></main><Footer/></BaseLayout>
<style>
.evangel-hero{background:#e5e1d9;padding:55px 0}.evangel-intro{row-gap:30px}.evangel-credits{grid-column:2;margin-top:0;gap:20px 30px;align-items:center}.evangel-live{margin-left:auto;white-space:nowrap;font-size:14px}.evangel-secondary{padding:55px 0;background:#e6e2d8}.evangel-about-grid{display:grid;grid-template-columns:0.8fr 1.2fr;gap:75px;align-items:center}.evangel-about-copy h2{font-size:clamp(28px,3vw,42px);line-height:1.12;margin:18px 0 25px}.evangel-about-copy p:not(.eyebrow){font-size:16px;line-height:1.7;color:#66635d;margin-bottom:18px}.evangel-content-pair{display:grid;grid-template-columns:1fr 1fr;gap:35px}.evangel-content-pair h3{font-size:19px;margin-bottom:14px;font-weight:500}.evangel-outcomes{display:grid;gap:25px}.evangel-outcomes p{font-size:14px;line-height:1.5;color:#66635d}.evangel-outcomes strong{display:block;font-size:24px;color:var(--ink);margin-bottom:8px;font-weight:500}@media(max-width:1000px){.evangel-live{margin-left:0}}@media(max-width:760px){.evangel-hero,.evangel-secondary{padding:30px 0}.evangel-credits{grid-column:1}.evangel-about-grid,.evangel-content-pair{grid-template-columns:1fr;gap:35px}}
</style>
