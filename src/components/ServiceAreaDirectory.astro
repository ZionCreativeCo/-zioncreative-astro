---
import type {serviceAreas} from '../data/service-areas';
interface Props {areas:typeof serviceAreas;}
const {areas}=Astro.props;
---
<div class="area-directory">{areas.map(area=><article id={area.id} aria-labelledby={`${area.id}-heading`}><p class="eyebrow">{area.state}</p><h3 id={`${area.id}-heading`}>{area.name}</h3><ul>{area.links.map(link=><li><a href={link.href}>{link.label}</a></li>)}</ul></article>)}</div>
<style>
.area-directory{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;min-width:0}.area-directory article{min-width:0;scroll-margin-top:30px;border:1px solid #c9c3b9;border-radius:12px;padding:28px;background:#f8f7f3}.area-directory .eyebrow{font-size:11px;color:#59574f;margin-bottom:16px}.area-directory h3{font-size:clamp(24px,2.6vw,32px);line-height:1.15;margin-bottom:18px;letter-spacing:-.025em}.area-directory ul{list-style:none;padding:0;margin:0}.area-directory li+li{border-top:1px solid #d5d0c7}.area-directory a{display:block;padding:15px 0;font-size:16px;line-height:1.5;overflow-wrap:anywhere;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:5px;min-height:44px}.area-directory a:focus-visible{outline:3px solid #7d8527;outline-offset:4px}@media(hover:hover) and (pointer:fine){.area-directory a:hover{text-decoration-color:currentColor}}@media(max-width:760px){.area-directory{grid-template-columns:1fr;gap:18px}.area-directory article{padding:24px}}
</style>
