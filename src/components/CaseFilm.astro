---
import dimensions from '../data/colossus-video-dimensions.json';
import {existsSync} from 'node:fs';
interface Props {name:string;label:string;portrait?:boolean;src?:string;poster?:string;width?:number;height?:number;address?:string;}
const {name,label,portrait=false,src=`/videos/colossus-${name}.mp4`,poster=`/images/colossus-${name}-poster.jpg`,width,height,address=name==='news-scroll'?'wearecolossus.com/news':'wearecolossus.com'}=Astro.props;
const mobileSrc=src.replace(/\.mp4$/, '-mobile.mp4');
const hasMobile=existsSync(`public${mobileSrc}`);
const optimizedPoster=poster.replace(/\.jpg$/, '-optimized.webp');
const displayPoster=existsSync(`public${optimizedPoster}`)?optimizedPoster:poster;
const eager=Astro.props.slot==='hero';
const size=width&&height?{width,height}:dimensions[name as keyof typeof dimensions];
---
{eager&&<link rel="preload" as="image" href={displayPoster} fetchpriority="high" />}
<div class:list={['case-film',{'case-film-portrait':portrait}]}> <div class:list={['film-window',{'film-window-phone':portrait}]}>{!portrait&&<div class="film-browser-bar" aria-hidden="true"><span class="film-browser-dots"><i></i><i></i><i></i></span><span>{address}</span><span>↗</span></div>}<video class="case-demo-video" width={size.width} height={size.height} controls autoplay={eager} data-eager={eager?'true':undefined} muted playsinline loop preload={eager?'auto':'none'} poster={displayPoster} aria-label={label}>{hasMobile&&<source src={mobileSrc} media="(max-width: 760px)" type="video/mp4" />}<source src={src} type="video/mp4" /></video></div></div>
<script>
const reduced=matchMedia('(prefers-reduced-motion: reduce)');
const clips=[...document.querySelectorAll<HTMLVideoElement>('.case-demo-video')];
const blocked=new WeakSet<HTMLVideoElement>();
const attempted=new WeakSet<HTMLVideoElement>();
const near=new WeakSet<HTMLVideoElement>();
function start(video:HTMLVideoElement){
 if(reduced.matches||document.hidden)return;
 attempted.add(video);
 video.autoplay=true;
 blocked.delete(video);
 video.play().catch(()=>{blocked.add(video);});
}
clips.forEach(video=>{
 // Set the properties as well as attributes for inline mobile autoplay.
 video.defaultMuted=true;
 video.muted=true;
 video.playsInline=true;
 video.loop=true;
 video.autoplay=!reduced.matches&&video.dataset.eager==='true';
 if(reduced.matches)video.pause();
 else if(video.dataset.eager==='true')start(video);
 video.addEventListener('play',()=>blocked.delete(video));
 video.addEventListener('canplay',()=>{if(near.has(video)&&blocked.has(video))start(video);},{once:true});
});
// Retry browser-deferred playback when a clip becomes visible, without
// restarting videos a visitor deliberately paused using the controls.
const observer=new IntersectionObserver(entries=>{
 entries.forEach(entry=>{
  const video=entry.target as HTMLVideoElement;
  if(entry.isIntersecting){near.add(video);if(!attempted.has(video)||blocked.has(video))start(video);}
  else near.delete(video);
 });
},{threshold:0,rootMargin:'300px 0px'});
clips.forEach(video=>observer.observe(video));
function retryBlocked(){clips.forEach(video=>{if(near.has(video)&&blocked.has(video))start(video);});}
document.addEventListener('visibilitychange',retryBlocked);
window.addEventListener('pageshow',retryBlocked);
reduced.addEventListener('change',()=>{
 clips.forEach(video=>{
  video.autoplay=!reduced.matches&&(near.has(video)||video.dataset.eager==='true');
  if(reduced.matches){blocked.delete(video);video.pause();}
  else if(near.has(video)||video.dataset.eager==='true')start(video);
 });
});
</script>
<style>.case-film{background:#e5e1d9;overflow:hidden;padding:clamp(20px,4.5vw,60px)}.film-window{border:1px solid #24251b38;border-radius:12px;overflow:hidden;background:#eeefea;box-shadow:0 24px 55px #20231c22;max-width:1168px;margin-inline:auto}.film-browser-bar{display:flex;justify-content:space-between;align-items:center;padding:12px 18px;font-size:11px;color:#64665f;gap:15px}.film-browser-dots{display:flex;gap:5px}.film-browser-dots i{width:5px;height:5px;border-radius:50%;background:#77796e}.film-window-phone{border:0;border-radius:0;background:transparent;box-shadow:none;margin:0}.case-film video{display:block;width:100%;height:auto}.case-film-portrait{background:#dcd8cd;padding:45px;display:flex;justify-content:center;align-items:center}.case-film-portrait video{max-width:330px;border:8px solid #252525;border-radius:32px;background:#111;box-shadow:0 25px 55px #28251f25}.case-film-portrait .film-window{max-width:330px}@media(max-width:760px){.case-film:not(.case-film-portrait){padding:20px 12px}.film-browser-bar{padding:9px 12px;font-size:9px}.film-window{border-radius:9px}.case-film-portrait{padding:30px}.case-film-portrait video{max-width:280px}}</style>
