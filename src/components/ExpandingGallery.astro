---
import villasPhotos from '../data/villas-gallery.json';
interface Props {photos?:{src:string;alt:string;position?:string;width:number;height:number}[];name?:string;rowSize?:number;}
const {photos=villasPhotos,name='The Villas',rowSize=6}=Astro.props;
const rows=Array.from({length:Math.ceil(photos.length/rowSize)},(_,index)=>photos.slice(index*rowSize,(index+1)*rowSize));
---
<div class="expanding-gallery" aria-label={`${name} photography gallery`}>
{rows.map((row,rowIndex)=><div class="gallery-rail" role="group" aria-label={`Photography row ${rowIndex+1}`}>
{row.map((photo,index)=><button class="gallery-panel" type="button" aria-label={`Expand photo: ${photo.alt}`} aria-pressed="false" style={`--photo-position:${photo.position??'50%'}`}><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async"/><span class="gallery-caption"><span>{String(rowIndex*rowSize+index+1).padStart(2,'0')}</span>{photo.alt}</span></button>)}
</div>)}
</div>
<script>
document.querySelectorAll<HTMLElement>('.gallery-rail').forEach(rail=>{
 const panels=[...rail.querySelectorAll<HTMLButtonElement>('.gallery-panel')];let pinned:HTMLButtonElement|null=null;
 const activate=(panel:HTMLButtonElement|null)=>panels.forEach(item=>{item.classList.toggle('is-active',item===panel);item.setAttribute('aria-pressed',String(item===panel));});
 panels.forEach((panel,index)=>{
 panel.addEventListener('pointerenter',event=>{if(event.pointerType!=='touch')activate(panel);});
 panel.addEventListener('focus',()=>activate(panel));
 panel.addEventListener('click',()=>{pinned=pinned===panel?null:panel;activate(pinned);});
 panel.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%panels.length;else if(event.key==='ArrowLeft')next=(index-1+panels.length)%panels.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=panels.length-1;else if(event.key==='Escape'){pinned=null;activate(null);return;}else return;event.preventDefault();panels[next].focus();});
 });
 rail.addEventListener('pointerleave',()=>activate(pinned??(panels.includes(document.activeElement as HTMLButtonElement)?document.activeElement as HTMLButtonElement:null)));
 rail.addEventListener('focusout',event=>{if(!rail.contains(event.relatedTarget as Node))activate(pinned);});
});
</script>
<style>
.expanding-gallery{display:grid;gap:14px;padding-bottom:75px}.gallery-rail{display:flex;gap:12px;height:480px}.gallery-panel{position:relative;flex:1;min-width:0;overflow:hidden;padding:0;border:0;border-radius:6px;background:#d8d2c7;cursor:pointer;transition:flex .65s cubic-bezier(.2,.75,.2,1);text-align:left}.gallery-panel.is-active{flex:5.5}.gallery-panel img{width:100%;height:100%;object-fit:cover;object-position:var(--photo-position) center;display:block}.gallery-caption{position:absolute;bottom:0;left:0;right:0;display:flex;align-items:end;gap:14px;background:linear-gradient(transparent,#111b);padding:70px 24px 24px;color:white;font-size:14px;line-height:1.4;opacity:0;transition:opacity .2s}.gallery-caption>span{font-size:12px;opacity:.7}.gallery-panel.is-active .gallery-caption{opacity:1;transition-delay:.2s}.gallery-panel:focus-visible{outline:3px solid var(--lime);outline-offset:3px;z-index:1}@media(max-width:760px){.expanding-gallery{gap:12px;padding-bottom:45px}.gallery-rail{height:390px;overflow-x:auto;padding:4px 4px 12px;gap:8px}.gallery-panel{flex:0 0 64px;transition:flex-basis .5s}.gallery-panel.is-active{flex:0 0 78vw;max-width:480px}.gallery-caption{padding:65px 18px 18px;font-size:13px}}@media(prefers-reduced-motion:reduce){.gallery-panel,.gallery-caption{transition:none}.gallery-panel.is-active .gallery-caption{transition-delay:0}}
</style>
