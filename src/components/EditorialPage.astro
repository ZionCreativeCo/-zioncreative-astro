---
import Arrow from './Arrow.astro';
import MarketingServices from './MarketingServices.astro';
import Media from './Media.astro';
import MediaGallery from './MediaGallery.astro';
import ProjectCTA from './ProjectCTA.astro';
import ElfsightWidget from './ElfsightWidget.astro';
import testimonials from '../data/testimonials.json';
const {page}=Astro.props;
const slug=page.slug;
const b=page.blocks;
const serviceLinks=['/contact','/logo-design-springfield-il','/web-design-springfield-il','/brand-management-services'];
const serviceAnchors=['strategy','branding','web','management'];
---
{slug==='services'&&<>
 <section class="container service-hero"><div class="service-hero-copy"><h1>Good ideas.<br /><em>Built to go further.</em></h1><p>{b[1][0].text}</p></div><div class="service-hero-image"><MediaGallery items={page.gallery.slice(0,1)} name="Brand and website design by Zion Creative" /></div></section>
 <section class="container service-chapters">{[4,8,12,16].map((index,i)=><article id={serviceAnchors[i]} class="service-chapter" data-reveal><div><p class="eyebrow">0{i+1} / {b[index-2][0].text}</p><h2>{b[index][0].text}</h2><ul>{b[index][1].text.split('\n').map((t:string)=><li>{t.replace(/^- /,'')}</li>)}</ul></div><div><h3>{b[index+1][0].text}</h3><p>{b[index+1][1].text}</p><a class="text-link" href={serviceLinks[i]}>{i===0?'Let’s talk strategy':'Explore this service'} <Arrow /></a></div></article>)}</section>
 <section class="section-dark"><div class="container supporting-services"><p class="eyebrow">More ways to move forward</p><a href="/graphic-design-springfield-il"><h2>Graphic design</h2><Arrow /></a><a href="/digital-marketing-springfield-il"><h2>Digital marketing</h2><Arrow /></a></div></section>
 </>}
{slug==='about-us'&&<>
 <section class="about-edge about-edge-right"><div class="about-edge-copy"><h1>Hello,<br /><em>nice to meet you.</em></h1><div class="rich-copy"><p>{b[1][0].text}</p></div><a class="text-link" href="/contact">Get to know us <Arrow /></a></div><div class="about-edge-image"><Media id={page.gallery[0].id} alt="Nick and Ellen, founders of Zion Creative" eager /></div></section>
 <section class="about-edge about-edge-left section-dark"><div class="about-edge-image"><Media id={page.gallery[1].id} alt="Examples of Zion Creative website design on mobile devices" /></div><div class="about-edge-copy"><p class="eyebrow">How we work</p><h2>{b[4][0].text}</h2><p>{b[6][0].text}</p></div></section>
 <section class="container capability-section"><p class="eyebrow">How we help</p><h2>{b[8][0].text}</h2><ul>{[...b[2][0].text.split('\n'),...b[5][0].text.split('\n')].map((x:string)=><li>{x}</li>)}</ul></section>
 <section class="section-dark"><div class="container client-words"><div class="section-heading"><div><p class="eyebrow">Good people. Good partnerships.</p><h2>Some kind words.</h2></div><a class="text-link" href="/testimonials">More client reviews <Arrow /></a></div><div class="testimonial-grid">{testimonials.map(t=><figure data-reveal><blockquote>“{t.quote}”</blockquote><figcaption>{t.name}</figcaption></figure>)}</div></div></section>
 </>}
{slug==='testimonials'&&<>
 <section class="container page-intro service-intro"><p class="eyebrow">Client testimonials</p><h1>Kind words.<br /><em>Lasting partnerships.</em></h1><p class="intro-copy">{b[0][2].text}</p></section>
 <section class="container widget-section" aria-label="Client reviews"><ElfsightWidget id="4c612829-2462-417f-80f8-aba169bfb84c"/><a class="text-link" href="https://www.squarespace.com/designer/profile/3770645">See reviews on Squarespace <Arrow /></a></section>
 </>}
{slug==='brand-management-services'&&<MarketingServices/>}
{slug==='consultation'&&<>
 <section class="container page-intro service-intro"><p class="eyebrow">Your next project starts here</p><h1>Let’s chat.</h1><p class="intro-copy">{b[1][0].text}</p></section>
 <section class="container scheduler" aria-label="Book a consultation"><div class="calendly-inline-widget" data-url="https://calendly.com/zioncreative/discovery?hide_event_type_details=1&amp;hide_gdpr_banner=1" style="min-width:280px;height:760px"></div><p>Prefer to book directly? <a class="text-link" href="https://calendly.com/zioncreative/discovery">Open the scheduler <Arrow /></a></p><noscript><p>Please use the direct scheduler link above to book your consultation.</p></noscript></section><script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
 </>}
{slug==='jobs'&&<section class="container page-intro service-intro utility-page"><p class="eyebrow">Work with Zion</p><h1>Good work starts<br /><em>with good people.</em></h1><p class="intro-copy">{b[0][1].text}</p><p>Still think you’d be a good fit?</p><a class="text-link" href="mailto:hello@zioncreative.co">Say hello <Arrow /></a></section>}
{slug==='onboarding'&&<><section class="container page-intro onboarding-intro"><h1>Let’s get started.</h1><p class="intro-copy">Tell us about your business, your goals, and the project you have in mind.</p></section><section class="container onboarding-form" aria-label="Client onboarding"><ElfsightWidget id="7e555f75-1e03-4532-8977-c377ed33d633" /></section></>}
{slug==='sample'&&<section class="container page-intro widget-section"><h1>Let’s connect.</h1><ElfsightWidget id="5cfa0b99-8564-4156-92a7-c14976c7a28b"/></section>}
{!['sample','onboarding','consultation','jobs'].includes(slug)&&<ProjectCTA marketing={slug==='brand-management-services'}/>}
