---
import Arrow from './Arrow.astro';
import Media from './Media.astro';
import MediaGallery from './MediaGallery.astro';
import ProjectCTA from './ProjectCTA.astro';
import ProjectCard from './ProjectCard.astro';
import portfolio from '../data/portfolio.json';
import dimensions from '../data/image-dimensions.json';
const {page}=Astro.props;
const coverSize=dimensions[page.cover.image as keyof typeof dimensions];
const next=portfolio[(portfolio.findIndex(p=>p.path===`/${page.slug}`)+1)%portfolio.length];
const website=['wholemoon','project/vpne','evangel','hill-country-linens','settlers-mtn','tpcns','sgk-law','project/kp'].includes(page.slug);
---
<div class:list={['original-case',{'original-case-website':website,'original-case-brand':!website}]}>
{!website&&<div class="original-case-cover">{page.gallery.length>0?<Media id={page.gallery[0].id} alt={page.gallery[0].alt||`${page.name} brand design`} eager />:<img src={`/images/${page.cover.image}-1280.webp`} width={coverSize.width} height={coverSize.height} alt={page.cover.alt} fetchpriority="high" />}</div>}
<section class="original-case-info" aria-label={`${page.name} project details`}>
 <div class="original-case-info-inner">
 {website?<><p class="case-disciplines">{page.roles.replaceAll('\n',' · ')}</p><h1>{page.name}</h1><dl class="original-case-meta">{page.details.map((d:{label:string;value:string})=><div><dt>{d.label}</dt><dd>{d.value}</dd></div>)}</dl><div class="rich-copy">{page.paragraphs.map((p:string)=><p>{p}</p>)}</div></>:<><div class="original-case-title"><h1>{page.name}</h1><p>{page.deck}</p></div><div class="original-case-role"><p class="role-label">Role</p><ul>{page.roles.split(/\n| · /).map((role:string)=><li>{role}</li>)}</ul>{page.details.length>0&&<dl class="original-case-meta">{page.details.map((d:{label:string;value:string})=><div><dt>{d.label}</dt><dd>{d.value}</dd></div>)}</dl>}</div><div class="rich-copy">{page.paragraphs.map((p:string)=><p>{p}</p>)}</div></>}
 <div class="original-case-links">{page.liveUrl&&<a class="text-link" href={page.liveUrl} target="_blank" rel="noopener noreferrer">Visit website <Arrow /></a>}<a class="text-link" href="/portfolio">Back to portfolio <Arrow /></a></div>
 </div>
</section>
<section class="original-case-gallery" aria-label={`${page.name} project gallery`}>
 {page.slug==='pillars-yogurt'&&<p class="original-gallery-caption">Colorway: Plain / Pillars Blue · Strawberry Banana · Mixed Berry · Vanilla · Mango</p>}
 <MediaGallery items={website?page.gallery:page.gallery.slice(1)} name={page.name} fullDesign />
</section>
</div>
{page.quote&&<section class="case-testimonial section-dark"><div class="container"><p class="eyebrow">In their words</p><blockquote class="standalone-quote">“{page.quote}”</blockquote>{page.attribution&&<p class="quote-attribution">{page.attribution}</p>}</div></section>}
<section class="container next-work"><div><p class="eyebrow">Keep exploring</p><h2>Next up.</h2><a class="text-link" href="/portfolio">All selected work <Arrow /></a></div><ProjectCard {...next}/></section>
<ProjectCTA />
