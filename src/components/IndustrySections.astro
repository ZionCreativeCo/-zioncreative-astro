---
import ServiceIcon from './ServiceIcon.astro';
import type {specialtyPages} from '../data/specialty-pages';
type SectionOptions=typeof specialtyPages.agency.sectionOptions;
interface Props {page:{audience:string;steps:{title:string;text:string}[];faqs:{q:string;a:string}[];sectionOptions?:SectionOptions & {investmentHref?:string;investmentCta?:string;processIcons?:string[];exploreIntro?:string}};}
const {page}=Astro.props;
const church=page.audience==='churches';
const law=page.audience==='law firms';
const food=page.audience==='food and beverage businesses';
const custom=page.sectionOptions;
const processIcons=custom?.processIcons??['email','strategy','web','management'];
const defaultMockup=food?{src:'/images/riccos-pizza-home.webp',alt:'Ricco’s Pizza website design with featured specialty pizzas',caption:'Ricco’s Pizza · Website redesign',href:'/riccos-pizza'}:law?{src:'/images/colossus-home-scroll-poster-optimized.webp',alt:'Colossus website developed by Zion Creative',caption:'Broader website work · Colossus',href:'/colossus'}:church?{src:'/images/kmcc-gather.webp',alt:'Koke Mill Church Gather page showing ministries and ways to get involved',caption:'Koke Mill Church · Gather page',href:'/koke-mill-church'}:{src:'/images/villas-detail-06-1280.webp',alt:'The Villas website showing care services and community information',caption:'The Villas · Website experience',href:'/the-villas'};
const mockup=custom?.mockup??{...defaultMockup,address:food?'Ricco’s Pizza':law?'wearecolossus.com':church?'kokemillchurch.org':'villasseniorcare.com',width:church?1600:1280,height:food?3202:law?800:church?6203:3666,artwork:false};
const explore=custom?.explore??[
 {href:'/web-design-springfield-il',title:'Website design',text:'Explore our approach to creating a website around your brand.',image:food?'work-dolce-anna':law?'work-colossus':church?'work-koke-mill-church':'work-the-villas',alt:food?'Dolce Anna gelateria website design':law?'Colossus website development':church?'Koke Mill Church website on a desktop monitor':'The Villas website design'},
 {href:'/portfolio',title:'More of our work',text:'Meet the brands and people we have partnered with.',image:food?'work-riccos-pizza':church?'work-evangel':'work-wholemoon',alt:food?'Ricco’s Pizza website redesign':church?'Evangel Church website on a laptop':'WholeMoon website design'},
 {href:'/brand-management-services',title:'Ongoing marketing',text:'Keep your website and creative working together after launch.',image:food?'work-anvil-and-forge':'villas-detail-08',alt:food?'Anvil and Forge brewery creative work':'Social media design mockups for The Villas'}
];
---
<section class="industry-process section-dark"><div class="container"><h2>A personal process.<br/><em>From the first conversation.</em></h2><div class="industry-process-grid">{page.steps.map((step,index)=><article><div class="process-step-top"><span class="process-step-icon"><ServiceIcon kind={processIcons[index]}/></span><span>0{index+1}</span></div><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></div></section>
<section class="industry-investment" aria-labelledby="industry-pricing-title"><div class="container industry-investment-grid"><div class="industry-investment-copy"><p class="eyebrow">Your investment</p><h2 id="industry-pricing-title">A clear<br/><em>starting point.</em></h2>{custom?<p>{custom.investmentCopy}</p>:<p>Custom Squarespace builds from <strong>$2,500</strong>. AI-built website hosting and care from <strong>$75/month</strong>, with the agreed initial build included and no startup fee. We agree on the scope before we begin.</p>}<a class="button" href={custom?.investmentHref??(custom&&page.audience!=='equestrian businesses'?'/contact':'/pricing/#websites')}>{custom?.investmentCta??(custom&&page.audience!=='equestrian businesses'?'Discuss your project':'Compare website options')}</a></div><figure class="industry-mockup"><a href={mockup.href}>{!mockup.artwork&&<div class="industry-mockup-bar" aria-hidden="true"><i></i><i></i><i></i><span>{mockup.address}</span></div>}<div class:list={["industry-mockup-screen",{"industry-mockup-artwork":mockup.artwork}]}><img src={mockup.src} width={mockup.width} height={mockup.height} alt={mockup.alt} loading="lazy" decoding="async"/></div></a><figcaption>{mockup.caption}<a href={mockup.href}>Explore the project</a></figcaption></figure></div></section>
<section class="industry-questions" aria-labelledby="industry-faq-title"><div class="container industry-faq"><div class="industry-faq-heading"><p class="eyebrow">Good questions</p><h2 id="industry-faq-title">{custom?.faqLabel??(food?'Restaurant website':law?'Law firm website':church?'Church website':'Senior living website')}<br/><em>questions.</em></h2><p>A few things to know before we get started.</p><a class="text-link" href="/contact">Have another question? Get in touch</a></div><div>{page.faqs.map(faq=><details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></div></section>
<section class="industry-explore section-dark" aria-labelledby="industry-explore-title"><div class="container"><div class="industry-heading"><div><p class="eyebrow">A little more Zion</p><h2 id="industry-explore-title">Keep <em>exploring.</em></h2></div><p>{custom?.exploreIntro??'From a new website to the creative that comes next.'}</p></div><div class="industry-explore-grid">{explore.map(item=><a class="industry-explore-card" href={item.href}><div class="industry-explore-image"><img src={`/images/${item.image}-1280.webp`} srcset={`/images/${item.image}-640.webp 640w, /images/${item.image}-1280.webp 1280w`} sizes="(max-width:760px) 100vw, 33vw" width="1280" height="960" alt={item.alt} loading="lazy" decoding="async"/></div><div class="industry-explore-copy"><h3>{item.title}</h3><p>{item.text}</p><span class="text-link">Take a look</span></div></a>)}</div></div></section>

<style>.industry-mockup-artwork{aspect-ratio:auto}</style>
