---
import ServiceIcon from './ServiceIcon.astro';
import Arrow from './Arrow.astro';
import ProjectCard from './ProjectCard.astro';
import portfolio from '../data/portfolio.json';
const projects=['/the-villas','/anvil-and-forge','/garrison-group'].map(path=>portfolio.find(p=>p.path===path)!);
const services=[
{icon:'strategy',title:'Marketing direction',copy:'Turn business goals into a practical plan. We help clarify your audience, sharpen your message, and prioritize the channels and projects that deserve your attention.'},
{icon:'web',title:'Website management',copy:'Keep your website working for your business with fresh content, new pages, campaign updates, and improvements to the experience as your needs evolve.'},
{icon:'social',title:'Social content & creative',copy:'Give your brand a consistent presence with thoughtfully designed posts, content ideas, and a visual system that makes ongoing communication feel connected.'},
{icon:'email',title:'Email marketing',copy:'Stay in touch with your audience through branded email layouts and clear, useful messages for announcements, promotions, and ongoing customer relationships.'},
{icon:'campaign',title:'Campaigns & collateral',copy:'Bring launches, events, and promotions together across digital and print. From landing pages to sales materials, every piece should feel like part of the same story.'},
{icon:'photo',title:'Photography & brand assets',copy:'Build a useful library of images and creative assets that show who you are, what you offer, and why it matters—ready for your website, social channels, and marketing materials.'}
];
const steps=[{title:'Get clear on the goals',copy:'We start with your business, your audience, and what you want marketing to help accomplish. Then we agree on the priorities and scope.'},{title:'Build a practical plan',copy:'Together, we map out the work, the channels, and the rhythm. You know what is coming, what we need from you, and where your input matters.'},{title:'Create, launch & refine',copy:'We develop the creative, coordinate feedback, and put the work into action. Regular check-ins help us review what is working and decide what comes next.'}];
---
<section class="marketing-hero"><div class="service-hero-copy"><h1>Manage your business.<br/><em>We’ll help market it.</em></h1><p>Ongoing marketing direction, creative, and website support for businesses that need a consistent presence—and a partner to keep things moving.</p><a class="button button-lime" href="/contact">Let’s talk marketing <Arrow/></a></div><div class="service-hero-image"><img src="/images/marketing-hero.webp" width="1448" height="1086" alt="Campaign materials, social creative, and brand assets in a warm studio setting" loading="eager"/></div></section>
<section class="section-dark marketing-capabilities"><div class="container"><div class="marketing-heading"><h2>Support where<br/><em>you need it.</em></h2><p>Start with the priorities that matter to your business. We’ll shape the mix of services around the work you need done.</p></div><div class="marketing-service-grid">{services.map((service)=><article><span class="marketing-icon"><ServiceIcon kind={service.icon}/></span><h3>{service.title}</h3><p>{service.copy}</p></article>)}</div></div></section>
<section class="marketing-process"><div class="container"><div class="marketing-heading"><h2>How we work together.</h2><p>A shared plan, clear communication, and room to adjust as your business grows.</p></div><div class="marketing-step-grid">{steps.map((step,index)=><article><span class="marketing-number">0{index+1}</span><h3>{step.title}</h3><p>{step.copy}</p></article>)}</div></div></section>
<section class="container marketing-work"><div class="section-heading"><h2>Creative that connects.</h2><a class="text-link" href="/portfolio">Explore our work <Arrow/></a></div><div class="marketing-projects">{projects.map(project=><ProjectCard {...project}/>)}</div></section>
<section class="section-dark marketing-questions"><div class="container"><h2>Make the partnership<br/><em>work for you.</em></h2><div class="marketing-question-grid"><details><summary><h3>Where do we start?</h3><span aria-hidden="true">+</span></summary><p>Tell us what is working, what is getting stuck, and what you want to accomplish. We’ll help identify a useful starting point before agreeing on a scope.</p></details><details><summary><h3>What does it cost?</h3><span aria-hidden="true">+</span></summary><p>Pricing depends on the services, volume of work, and level of ongoing support. We’ll outline the scope and investment together, so the priorities are clear before we begin.</p></details><details><summary><h3>Can you work with our team?</h3><span aria-hidden="true">+</span></summary><p>Yes. We can support an existing team or provide a dedicated creative partner for your business. We’ll establish responsibilities, feedback, and communication from the start.</p></details></div></div></section>
<style>
.marketing-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(35px,5vw,75px);overflow:hidden}.marketing-hero .service-hero-image{order:-1;align-self:stretch}.marketing-hero .service-hero-image img{width:100%;height:100%;object-fit:cover}.marketing-hero .service-hero-copy{padding:55px max(56px,calc((100vw - 1320px)/2)) 55px 0}.marketing-icon{display:block;color:var(--lime);margin-bottom:22px}.marketing-icon :global(svg){width:36px;height:36px}.marketing-intro,.marketing-fit{display:grid;grid-template-columns:1fr 1fr;gap:80px;padding-block:35px 80px}.marketing-intro h2,.marketing-fit h2{font-size:clamp(34px,3.6vw,52px)}.marketing-intro p,.marketing-fit p{color:#66635d;font-size:17px;line-height:1.7}.marketing-intro p+p{margin-top:20px}.marketing-capabilities,.marketing-process,.marketing-questions{padding-block:75px}.marketing-heading{display:flex;justify-content:space-between;gap:50px;align-items:end;margin-bottom:45px}.marketing-heading h2,.marketing-questions h2{font-size:clamp(36px,4vw,56px)}.marketing-heading>p{max-width:440px;font-size:17px;line-height:1.65}.section-dark .marketing-heading>p{color:#d4d0c6}.marketing-service-grid,.marketing-step-grid,.marketing-projects,.marketing-question-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.marketing-service-grid article{border:1px solid #ffffff25;border-radius:14px;padding:30px}.marketing-number{display:block;font-size:13px;margin-bottom:22px;color:var(--lime)}.marketing-service-grid h3,.marketing-step-grid h3,.marketing-fit h3{font-size:25px;margin-bottom:16px}.marketing-service-grid p{font-size:16px;color:#d4d0c6;line-height:1.65}.marketing-fit{padding-block:80px}.marketing-fit>div>p{margin-top:25px}.marketing-fit-list article{border-top:1px solid #c9c3b9;padding:25px 0}.marketing-fit-list article:last-child{padding-bottom:0}.marketing-process{background:#e5e1d9}.marketing-process .marketing-number{color:#66635d}.marketing-step-grid article{padding-top:25px;border-top:1px solid #bbb5ab}.marketing-step-grid p{font-size:16px;color:#66635d;line-height:1.65}.marketing-work{padding-block:75px}.marketing-work h2{font-size:clamp(36px,4vw,56px)}.marketing-projects :global(.project-caption h3){font-size:24px}.marketing-projects :global(.project-caption p){font-size:13px;color:#66635d}.marketing-projects :global(.project-number){display:none}.marketing-projects :global(.project-image){border-radius:12px}.marketing-question-grid{margin-top:40px;align-items:start}.marketing-question-grid details{border:1px solid #ffffff25;border-radius:14px;background:#ffffff07;padding:28px}.marketing-question-grid summary{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:64px;cursor:pointer;list-style:none}.marketing-question-grid summary::-webkit-details-marker{display:none}.marketing-question-grid summary h3{font-size:25px;color:var(--lime)}.marketing-question-grid summary span{font-size:28px;color:var(--lime)}.marketing-question-grid details[open] summary span{transform:rotate(45deg)}.marketing-question-grid p{padding-top:22px;font-size:16px;color:#d4d0c6;line-height:1.65}.marketing-question-grid summary:focus-visible{outline:3px solid var(--lime);outline-offset:7px}.marketing-contact-card{background:#e5e1d9;border-radius:14px;padding:35px;align-self:center}.marketing-contact-card h3{font-size:28px;margin-bottom:18px}.marketing-contact-card .button{margin-top:25px}.marketing-conversation{padding-top:75px;scroll-margin-top:30px}.marketing-conversation p{color:#66635d;font-size:17px;max-width:450px}@media(max-width:1000px){.marketing-intro,.marketing-fit{gap:40px}.marketing-service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.marketing-intro,.marketing-fit,.marketing-service-grid,.marketing-step-grid,.marketing-projects,.marketing-question-grid{grid-template-columns:1fr;gap:25px}.marketing-intro{padding-block:10px 45px}.marketing-fit,.marketing-capabilities,.marketing-process,.marketing-work,.marketing-questions{padding-block:45px}.marketing-heading{display:block;margin-bottom:30px}.marketing-heading>p{margin-top:22px}.marketing-hero{grid-template-columns:1fr;gap:0}.marketing-hero .service-hero-copy{padding:35px 20px 45px}.marketing-hero .service-hero-image{height:auto}.marketing-hero .service-hero-image img{height:auto}.marketing-contact-card{background:#e5e1d9;border-radius:14px;padding:35px;align-self:center}.marketing-contact-card h3{font-size:28px;margin-bottom:18px}.marketing-contact-card .button{margin-top:25px}.marketing-conversation{padding-top:45px}}
</style>
