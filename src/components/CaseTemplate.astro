---
import Arrow from './Arrow.astro';
import SeeMore from './SeeMore.astro';
import portfolio from '../data/portfolio.json';
import {siteLink} from '../lib/links';
interface Props {name:string;tagline:string;related:string[];}
const {name,tagline,related}=Astro.props;
const projects=related.map(path=>portfolio.find(p=>p.path===path)).filter(Boolean);
---
<article class="clean-case"><header class="container clean-case-title"><a href="/portfolio" class="clean-case-back" aria-label="Back to portfolio"><Arrow /></a><div><h1>{name}</h1><p>{tagline}</p></div></header><slot name="hero"/><div class="clean-case-story"><slot/></div><section class="container clean-related" aria-labelledby="related-title"><h2 id="related-title">Related work</h2><div class="clean-related-grid">{projects.map(project=><a class="clean-related-card" href={siteLink(project!.path)}><img src={`/images/${project!.image}-640.webp`} width="640" height="800" alt={project!.alt} loading="lazy"/><span class="related-name">{project!.name}</span><SeeMore/></a>)}</div></section></article>
<style is:global>
.clean-case{background:#f8f7f3}.clean-case-title{display:flex;align-items:center;gap:40px;padding-block:50px 65px}.clean-case-title h1{font-size:clamp(34px,4vw,52px);line-height:1.1;letter-spacing:-.03em;margin:0 0 12px}.clean-case-title p{font-size:clamp(18px,2vw,25px);font-weight:500}.clean-case-back{flex-shrink:0;display:flex;padding:12px}.clean-case-back .zion-arrow{width:29px;height:24px;transform:rotate(180deg)}.clean-story-section{display:grid;grid-template-columns:160px 1fr;gap:55px;padding-block:75px}.clean-story-section>.eyebrow{padding-top:8px;font-size:12px}.clean-story-copy{max-width:850px}.clean-story-copy h2{font-size:clamp(28px,3vw,42px);line-height:1.15;letter-spacing:-.03em;margin-bottom:25px}.clean-story-copy p{font-size:17px;line-height:1.7;color:#55534d;max-width:780px}.clean-story-copy p+p{margin-top:20px}.clean-story-copy .text-link{margin-top:25px;font-size:14px}.clean-case-credits{display:flex;gap:15px 50px;flex-wrap:wrap;margin-top:30px;padding-top:25px;border-top:1px solid #d5d2ca;font-size:13px;color:#55534d}.clean-case-credits strong{display:block;color:var(--ink);margin-bottom:5px}.clean-case-media{width:100%;display:block}.clean-case-media img{width:100%;height:auto;display:block}.clean-media-pair{display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:stretch}.clean-media-pair>figure{margin:0;min-width:0}.clean-media-pair img{width:100%;height:100%;object-fit:cover;display:block}.clean-media-pair .case-film:not(.case-film-portrait){align-self:center}.clean-media-pair.video-pair{background:#e7e3da;align-items:center}.clean-impact{background:#e8e7df;padding-block:75px}.clean-impact-inner{display:grid;grid-template-columns:1fr 1fr;gap:85px;align-items:center}.clean-impact-facts{display:grid;grid-template-columns:1fr 1fr;gap:35px 30px}.clean-impact-facts p{font-size:13px;color:#65625a;line-height:1.5}.clean-impact-facts strong{display:block;font-size:clamp(27px,3vw,44px);color:var(--ink);line-height:1.1;margin-bottom:12px;font-weight:500;letter-spacing:-.025em}.clean-impact .eyebrow{font-size:12px;margin-bottom:20px}.clean-impact h2{font-size:clamp(28px,3vw,42px);line-height:1.15;letter-spacing:-.03em;margin-bottom:25px}.clean-impact-copy>p:not(.eyebrow){font-size:16px;line-height:1.7;color:#55534d}.clean-related{padding-block:75px 85px}.clean-related h2{font-size:22px;text-transform:uppercase;letter-spacing:0;margin-bottom:35px}.clean-related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.clean-related-card{touch-action:manipulation;position:relative;display:block;border-radius:20px;overflow:hidden;aspect-ratio:1.22}.clean-related-card>*{pointer-events:none}.clean-related-card>img{width:100%;height:100%;object-fit:cover;transition:transform .35s}.related-name{position:absolute;bottom:30px;left:30px;background:#232323;color:#fff;padding:14px 20px;border-radius:3px;font-size:17px;font-weight:550}.clean-related-card:focus-visible{outline:3px solid var(--lime);outline-offset:5px}@media(max-width:900px){.clean-story-section{grid-template-columns:110px 1fr;gap:30px}.clean-impact-inner{gap:40px}.clean-related-grid{gap:20px}.related-name{bottom:20px;left:20px;font-size:14px}}@media(max-width:760px){.clean-case-title{padding-block:30px 40px;gap:20px}.clean-case-back{padding:0}.clean-story-section{grid-template-columns:1fr;gap:20px;padding-block:45px}.clean-story-copy p{font-size:16px}.clean-media-pair{grid-template-columns:1fr}.clean-media-pair img{height:auto}.clean-impact{padding-block:50px}.clean-impact-inner{grid-template-columns:1fr;gap:45px}.clean-impact-facts{gap:30px}.clean-related{padding-block:50px}.clean-related-grid{grid-template-columns:1fr;gap:20px}.clean-related-card{aspect-ratio:1.4}.clean-case-credits{gap:20px}.clean-related h2{font-size:20px}}@media(prefers-reduced-motion:reduce){.clean-related-card>img{transition:none}}
</style>
