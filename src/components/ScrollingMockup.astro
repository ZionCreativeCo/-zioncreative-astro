---
import capture from '../data/colossus-home-capture.json';
---
<div class="scrolling-mockup"><div class="browser-bar" aria-hidden="true"><span>● ● ●</span><span>wearecolossus.com</span><span>↗</span></div><div class="mockup-viewport" tabindex="0" role="region" aria-label="Scroll through the full Colossus homepage"><div class="homepage-strip" style={`aspect-ratio:1280/${capture.height}`}>{capture.tiles.map(tile=><img src={tile.src} width="1280" height="720" style={`top:${tile.y/capture.height*100}%`} alt={tile.y===0?'Full Colossus homepage, from the agency introduction to featured work, testimonials, news and footer':''} loading="eager" />)}</div></div><div class="mockup-controls"><span>Explore the full homepage</span><button class="mockup-pause" type="button" aria-pressed="false">Pause scrolling</button></div></div>
<script>
const viewport=document.querySelector<HTMLElement>('.mockup-viewport');const button=document.querySelector<HTMLButtonElement>('.mockup-pause');
if(viewport&&button){const motion=matchMedia('(prefers-reduced-motion: reduce)');let paused=motion.matches;let hovering=false;let visible=false;let direction=1;let last=0;let holdUntil=performance.now()+2200;
const update=()=>{button.textContent=paused?'Play scrolling':'Pause scrolling';button.setAttribute('aria-pressed',String(paused));};update();
button.addEventListener('click',()=>{paused=!paused;update();});
viewport.addEventListener('pointerenter',()=>hovering=true);viewport.addEventListener('pointerleave',()=>hovering=false);
const pause=()=>{paused=true;update();};viewport.addEventListener('wheel',pause,{passive:true});viewport.addEventListener('touchstart',pause,{passive:true});viewport.addEventListener('keydown',pause);
motion.addEventListener('change',()=>{if(motion.matches)pause();});new IntersectionObserver(entries=>visible=entries[0].isIntersecting).observe(viewport);
const tick=(now:number)=>{const elapsed=Math.min(now-last,50);last=now;if(!paused&&!hovering&&visible&&now>holdUntil&&!viewport.matches(':focus')){const max=viewport.scrollHeight-viewport.clientHeight;viewport.scrollTop+=direction*elapsed*.045;if(viewport.scrollTop>=max-1){direction=-1;holdUntil=now+1800;}else if(viewport.scrollTop<=0){direction=1;holdUntil=now+1800;}}requestAnimationFrame(tick);};requestAnimationFrame(tick);}
</script>
<style>
.scrolling-mockup{border:1px solid #24251b38;border-radius:12px;overflow:hidden;box-shadow:0 24px 55px #20231c22;background:#eeefea}.browser-bar{display:flex;justify-content:space-between;padding:12px 18px;font-size:11px;color:#64665f}.browser-bar span:first-child{letter-spacing:3px;font-size:9px}.mockup-viewport{aspect-ratio:16/9;overflow-y:auto;scrollbar-width:thin;background:#161616}.mockup-viewport:focus-visible{outline:3px solid #24251b;outline-offset:-3px}.homepage-strip{width:100%;position:relative;overflow:hidden}.homepage-strip img{position:absolute;width:100%;height:auto;display:block}.mockup-controls{display:flex;align-items:center;justify-content:space-between;padding:12px 18px;font-size:12px}.mockup-pause{font:inherit;background:transparent;border:1px solid #b6b7ad;border-radius:30px;padding:6px 12px;cursor:pointer}.mockup-pause:hover{background:var(--lime)}@media(max-width:760px){.browser-bar{padding:8px;font-size:8px}.mockup-controls{padding:10px;font-size:10px}}
</style>
