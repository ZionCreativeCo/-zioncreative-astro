---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CaseTemplate from './CaseTemplate.astro';
import CaseFilm from './CaseFilm.astro';
import ScrollableScreen from './ScrollableScreen.astro';
import ProjectCTA from './ProjectCTA.astro';
import screens from '../data/food-screens.json';
import {foodProjects} from '../data/food-projects';
interface Props{project:typeof foodProjects[keyof typeof foodProjects];}
const {project}=Astro.props;
---
<BaseLayout title={project.title} description={project.description}><Header/><main id="main"><CaseTemplate name={project.name} tagline={project.tagline} related={project.related}>
<CaseFilm slot="hero" name={`${project.slug}-experience`} label={`${project.name} custom Squarespace website walkthrough`} src={`/videos/${project.slug}-experience.mp4`} poster={`/images/${project.slug}-experience-poster.webp`} width={1440} height={project.height} address={project.address}/>
<section class="container clean-story-section food-case-intro"><p class="eyebrow">The project</p><div class="clean-story-copy"><h2 set:html={project.heading}/>{project.intro.map(text=><p>{text}</p>)}</div><div class="clean-case-credits food-case-credits"><div><strong>Our role</strong>{project.role}</div><div><strong>Platform</strong>Squarespace</div><div><strong>Location</strong>{project.location}</div><div><strong>Industry</strong>Food &amp; beverage</div></div></section>
<section class="food-case-detail" style={`--food-tone:${project.tone}`}><div class="container food-case-detail-grid"><div class="clean-story-copy"><p class="eyebrow">The experience</p><h2 set:html={project.detailHeading}/><p>{project.detail}</p></div><a class="food-case-preview" href="#page-screens" aria-label={`Explore the full ${project.name} page designs`}><img src={`/images/${project.slug}-ipad-1280.webp`} srcset={`/images/${project.slug}-ipad-640.webp 640w, /images/${project.slug}-ipad-1280.webp 1280w`} sizes="(max-width:760px) 100vw, 58vw" width={1280} height={960} alt={`${project.name} website displayed on an iPad`} loading="lazy" decoding="async"/></a></div></section>
<section class="container clean-story-section" id="page-screens"><p class="eyebrow">Explore the pages</p><div class="clean-story-copy"><h2 set:html={project.screenHeading}/><p>{project.screenCopy}</p></div></section>
<div class="food-case-screens" style={`--food-tone:${project.tone}`}><div class="container food-screen-grid">{project.screens.map((screen,index)=><div class:list={{'food-screen-wide':project.screens.length===3&&index===0}}><ScrollableScreen image={screens[screen.key as keyof typeof screens]} title={screen.title} address={`${project.name} / ${screen.title}`} brand={project.name} primary={project.screens.length===3&&index===0}/></div>)}</div></div>
<section class="clean-impact"><div class="container clean-impact-inner"><div class="clean-impact-facts">{project.facts.map(fact=><p><strong>{fact.value}</strong>{fact.label}</p>)}</div><div class="clean-impact-copy"><p class="eyebrow">The result</p><h2 set:html={project.impactHeading}/><p>{project.impact}</p><p><a class="text-link" href="/food-and-beverage-web-design/">Explore restaurant &amp; food website design</a></p></div></div></section>
</CaseTemplate><ProjectCTA/></main><Footer/></BaseLayout>
<style>
.food-case-intro{row-gap:28px}.food-case-credits{grid-column:2;margin-top:0;gap:22px 40px}.food-case-detail,.food-case-screens{background:var(--food-tone);padding-block:65px}.food-case-detail-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:center}.food-case-detail .eyebrow{margin-bottom:22px}.food-case-preview{display:block;min-width:0;overflow:hidden;border-radius:12px;background:var(--food-tone)}.food-case-preview img{display:block;width:100%;height:auto}.food-screen-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:50px 35px}.food-screen-wide{grid-column:1/-1}.clean-impact-copy .text-link{font-size:14px;margin-top:22px}@media(max-width:900px){.food-case-detail-grid{gap:35px}}@media(max-width:760px){.food-case-credits{grid-column:1}.food-case-detail,.food-case-screens{padding-block:40px}.food-case-detail-grid,.food-screen-grid{grid-template-columns:1fr;gap:35px}.food-case-preview{transform:none}.food-screen-wide{grid-column:auto}}
</style>
