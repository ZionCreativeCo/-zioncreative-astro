---
import ServiceIcon from './ServiceIcon.astro';
import GraphicDesignHero from './GraphicDesignHero.astro';
import MediaGallery from './MediaGallery.astro';
import ProjectCTA from './ProjectCTA.astro';
import LocalServiceContext from './LocalServiceContext.astro';
import Arrow from './Arrow.astro';
import Media from './Media.astro';
import ProjectCard from './ProjectCard.astro';
import portfolio from '../data/portfolio.json';
const {page}=Astro.props;
const names:Record<string,string>={'logo-design-springfield-il':'Brand identities & logo design.','web-design-springfield-il':'Websites built around your brand.','graphic-design-springfield-il':'Good design. Real purpose.','digital-marketing-springfield-il':'Make your next move count.'};
const intro=page.blocks.flat().find((x:{tag:string})=>x.tag==='p')?.text;
const sections=page.blocks.filter((b:{tag:string;text:string}[])=>b.some(x=>x.tag==='p')).map((b:{tag:string;text:string}[])=>b.filter(x=>x.text!==intro)).filter((b:unknown[])=>b.length);
const isGraphic=page.slug==='graphic-design-springfield-il';
const isLogo=page.slug==='logo-design-springfield-il';
const isMarketing=page.slug==='digital-marketing-springfield-il';
const isDesign=isGraphic||isLogo||isMarketing;
const logoSections=[['Logo concepts','Distinctive logo concepts grounded in your business, audience and goals. Our intentional process gives your identity a clear direction, with feedback shaping the final mark.'],['Logo variations','Primary and secondary logos that work across different spaces and sizes, with original vector artwork and the file formats you need for digital and print.'],['Color & typography','A coordinated color palette and font selection that bring personality and consistency to every brand touchpoint.'],['Brand style guide','A practical guide to your logos, colors and fonts, helping your team keep the brand recognizable as your business grows.'],['Business cards','Business card design for up to three people, translating your new identity into a polished first impression. Printing is quoted separately.'],['Social & email graphics','Profile and banner graphics for your social channels, alongside graphics for email profiles, so your identity carries through to everyday communication.']].map(([title,text])=>[{tag:'h3',text:title},{tag:'p',text}]);
const designSections=isLogo?logoSections:sections;
const graphicExamples=['/bfg','/pillars-yogurt','/anvil-and-forge','/the-villas','/garrison-group','/lingk'].map(path=>portfolio.find(project=>project.path===path)!);
const isWeb=page.slug==='web-design-springfield-il';
const hasCardToggles=isWeb||page.slug==='logo-design-springfield-il';
const webExamples=['/koke-mill-church','/project/equiventures-east','/project/kp','/the-villas','/colossus','/wholemoon'].map(path=>portfolio.find(project=>project.path===path)!);
const imageLeft=['web-design-springfield-il','digital-marketing-springfield-il'].includes(page.slug);
---
{isDesign?<GraphicDesignHero intro={intro} logo={isLogo} marketing={isMarketing}/>:<section class:list={[(isWeb||isGraphic)?'web-edge-hero section-dark':'container service-hero',{'service-hero-image-left':imageLeft,'web-stacked-hero':isWeb}]}>
 <div class="service-hero-copy"><a class="text-link" href="/services">Our services <Arrow /></a><h1>{names[page.slug]}</h1><p>{intro}</p><a class="button button-lime" href="/contact">Start a conversation <Arrow /></a></div>
 {page.gallery.length>0&&<div class="service-hero-image">{(isWeb||isGraphic)?<Media id={page.gallery[0].id} alt={isGraphic?"Social media campaign designs for The Villas":"Zion Creative website design shown on mobile devices"} eager/>:<MediaGallery items={page.gallery.slice(0,1)} name={names[page.slug]}/>}</div>}
</section>}
{isWeb&&<section class="container web-examples" aria-labelledby="web-examples-title"><div class="section-heading"><h2 id="web-examples-title">Websites with character.</h2><a class="text-link" href="/portfolio">Explore all work <Arrow/></a></div><p class="industry-service-link">Built around your industry: <a href="/law-firm-web-design">law firms</a>, <a href="/church-web-design">churches</a>, <a href="/senior-living-web-design">senior living communities</a>, and <a href="/food-and-beverage-web-design">restaurants &amp; food brands</a>.</p><p class="industry-service-link">Specialist website support: <a href="/webflow-development-for-agencies">creative agency development</a>, <a href="/shopify-food-beverage-brands">Shopify for food &amp; beverage brands</a>, and <a href="/equestrian-web-design">equestrian businesses</a>.</p><div class="web-examples-grid">{webExamples.map(project=><ProjectCard {...project}/>)}</div></section>}
{!isDesign&&sections.length>0&&<section class="container service-explainer"><div class="service-explainer-heading"><h2>{page.slug==='logo-design-springfield-il'?'More than a mark.':'What we can create.'}</h2></div><div class="service-explainer-content">{sections.map((b:{tag:string;text:string}[])=><article data-reveal>{b.map(x=>x.tag.startsWith('h')?<h3>{x.text}</h3>:<p>{x.text}</p>)}</article>)}</div></section>}
{hasCardToggles&&!isLogo&&page.faqs.length>0&&<section class="web-information section-dark"><div class="container"><div class="web-information-heading"><h2>Process, pricing<br/><em>&amp; good questions.</em></h2><p>{isWeb?'Everything you need to know about building your next website.':'What to expect when creating your brand identity.'}</p></div><div class="web-information-grid">{page.faqs.map((f:{title:string;paragraphs:string[]})=><details class="web-information-card"><summary><h3>{f.title}</h3><span aria-hidden="true">+</span></summary><div class="web-information-body">{f.paragraphs.map((p,index)=>f.title==='Our Process'&&index%2===0?<h4>{p}</h4>:<p>{p.replace('Learn More →','').replace('launch.Need','launch. Need').replace('delivery.Need','delivery. Need').replace('Yeah – we do that. Want','Yeah – we do that. Want')}</p>)}{f.title==='Pricing'&&<a class="text-link" href="/pricing">Compare packages <Arrow/></a>}{f.title==='Web Management Services'&&<a class="text-link" href="/brand-management-services">Explore management plans <Arrow/></a>}</div></details>)}</div></div></section>}
{!hasCardToggles&&page.faqs.length>0&&<section class="section-dark faq-section"><div class="container faq-grid"><div><p class="eyebrow">The details</p><h2>Process, pricing<br /><em>& good questions.</em></h2></div><div>{page.faqs.map((f:{title:string;paragraphs:string[]})=><details><summary>{f.title}<span aria-hidden="true">+</span></summary><div>{f.paragraphs.map(p=><p>{p.replace('Learn More →','').replace('launch.Need','launch. Need').replace('delivery.Need','delivery. Need')}</p>)}{f.title==='Pricing'&&<a class="text-link" href="/pricing">Compare packages <Arrow/></a>}{f.title==='Web Management Services'&&<a class="text-link" href="/brand-management-services">Explore management plans <Arrow /></a>}</div></details>)}</div></div></section>}
{!isWeb&&!isDesign&&page.gallery.length>1&&<section class="container case-section"><div class="section-heading"><div><p class="eyebrow">A few examples</p><h2>Made for real brands.</h2></div><a class="text-link" href="/portfolio">See the work <Arrow /></a></div><MediaGallery items={page.gallery.slice(1)} name={names[page.slug]} compact={page.slug==='logo-design-springfield-il'}/></section>}
{isDesign&&<>

<section class="container graphic-capabilities" aria-labelledby="graphic-capabilities-title"><div class="section-heading"><h2 id="graphic-capabilities-title">{isMarketing?<>Clear strategy.<br/>Connected marketing.</>:isLogo?<>One identity.<br/>Every expression.</>:<>Thoughtful design.<br/>Every touchpoint.</>}</h2><p>{isMarketing?"Strategy, content and campaigns working toward the same goal.":"From the first impression to the everyday details."}</p></div><div class="graphic-capability-grid">{designSections.map((block,index)=><article data-reveal><span class="graphic-card-icon"><ServiceIcon kind={(isMarketing?['campaign','strategy','social','photo','web','management']:isLogo?['branding','packaging','photo','print','email','social']:['campaign','branding','social','print','web','packaging'])[index]}/></span>{block.map(x=>x.tag.startsWith('h')?<h3>{x.text}</h3>:<p>{x.text}</p>)}</article>)}</div></section>
<section class="container graphic-local"><h2>{isMarketing?"Digital marketing for Springfield businesses.":isLogo?"Logo design for Springfield businesses.":"Graphic design for Springfield businesses."}</h2><p>{isMarketing?"Based in Springfield, Illinois, Zion Creative helps businesses connect their content, advertising and website into a coordinated marketing strategy. We start with your goals and audience, develop creative that fits your brand, and use performance insights to refine the work. From local search visibility to ongoing campaigns, each channel has a clear role in supporting your next step.":isLogo?"Based in Springfield, Illinois, Zion Creative creates logos and brand identities for businesses and organizations ready for a clear, recognizable presence. From a new business launch to an established brand refresh, we build an identity that reflects your values and works across your website, signage, packaging and marketing materials.":"Based in Springfield, Illinois, Zion Creative helps businesses and organizations build a consistent presence across print, packaging and digital channels. Whether you need a new identity, materials for a local launch or ongoing campaign graphics, we connect each piece to your brand and the people you want to reach."}</p><div><a class="text-link" href={isLogo?"/graphic-design-springfield-il":"/logo-design-springfield-il"}>{isLogo?"Explore graphic design":"Explore logo design"} <Arrow/></a><a class="text-link" href="/web-design-springfield-il">Explore website design <Arrow/></a></div></section>
{isLogo&&<section class="container logo-design-gallery" aria-labelledby="logo-gallery-title"><div class="section-heading"><h2 id="logo-gallery-title">A few more identities.</h2></div><MediaGallery items={page.gallery} name="Logo design by Zion Creative" compact/></section>}
<section class="section-dark graphic-selected-work"><div class="container"><div class="section-heading"><h2>{isMarketing?"Creative that connects.":"Design in the real world."}</h2><a class="text-link" href="/portfolio">Explore all work <Arrow/></a></div><div class="web-examples-grid">{(isMarketing?['/the-villas','/anvil-and-forge','/pillars-yogurt'].map(path=>portfolio.find(project=>project.path===path)!):isLogo?['/little-pond','/lingk','/garrison-group'].map(path=>portfolio.find(project=>project.path===path)!):graphicExamples).map(project=><ProjectCard {...project}/>)}</div></div></section>
</>}
{isLogo&&page.faqs.length>0&&<section class="web-information section-dark"><div class="container"><div class="web-information-heading"><h2>Process, pricing<br/><em>&amp; good questions.</em></h2><p>{isWeb?'Everything you need to know about building your next website.':'What to expect when creating your brand identity.'}</p></div><div class="web-information-grid">{page.faqs.map((f:{title:string;paragraphs:string[]})=><details class="web-information-card"><summary><h3>{f.title}</h3><span aria-hidden="true">+</span></summary><div class="web-information-body">{f.paragraphs.map((p,index)=>f.title==='Our Process'&&index%2===0?<h4>{p}</h4>:<p>{p.replace('Learn More →','').replace('launch.Need','launch. Need').replace('delivery.Need','delivery. Need').replace('Yeah – we do that. Want','Yeah – we do that. Want')}</p>)}{f.title==='Pricing'&&<a class="text-link" href="/pricing">Compare packages <Arrow/></a>}{f.title==='Web Management Services'&&<a class="text-link" href="/brand-management-services">Explore management plans <Arrow/></a>}</div></details>)}</div></div></section>}
<script type="application/ld+json" set:html={JSON.stringify({
 '@context':'https://schema.org','@type':'Service',
 '@id':new URL(Astro.url.pathname,Astro.site).href+'#service',
 name:isWeb?'Website Design in Springfield, Illinois':isLogo?'Logo Design and Branding in Springfield, Illinois':isMarketing?'Digital Marketing in Springfield, Illinois':'Graphic Design in Springfield, Illinois',
 serviceType:isWeb?'Website design and development':isLogo?'Logo design and branding':isMarketing?'Digital marketing':'Graphic design',
 provider:{'@type':'Organization','@id':'https://www.zioncreative.co/#organization',name:'Zion Creative',url:'https://www.zioncreative.co/'},
 areaServed:{'@type':'City',name:'Springfield, Illinois'},
 url:new URL(Astro.url.pathname,Astro.site).href,description:page.description
})}/>
<LocalServiceContext kind={isWeb?'web':isLogo?'branding':isMarketing?'marketing':'design'}/>
<ProjectCTA/>

<style>
.logo-design-gallery{padding-bottom:75px}.logo-design-gallery h2{font-size:clamp(32px,3.6vw,50px)}.logo-design-gallery :global(.media-gallery){gap:24px}.logo-design-gallery :global(figure){overflow:hidden;border-radius:12px}.logo-design-gallery :global(img){object-fit:contain}@media(max-width:760px){.logo-design-gallery{padding-bottom:45px}.logo-design-gallery :global(.media-gallery){grid-template-columns:1fr 1fr;gap:14px}}
.graphic-local{padding-block:0 75px;display:grid;grid-template-columns:1fr 1.2fr;gap:30px 70px}.graphic-local h2{font-size:clamp(32px,3.6vw,50px)}.graphic-local p{color:#5d5b55}.graphic-local>div{grid-column:2;display:flex;flex-wrap:wrap;gap:20px 35px}@media(max-width:760px){.graphic-local{grid-template-columns:1fr;gap:24px;padding-bottom:45px}.graphic-local>div{grid-column:auto}}
.graphic-capabilities{padding-block:75px}.graphic-capabilities .section-heading>p{max-width:300px;font-size:17px;color:#66635d}.graphic-capability-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.graphic-capability-grid article{border:1px solid #d1cec5;border-radius:14px;padding:30px;background:#f8f7f3}.graphic-card-icon{display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:12px;background:var(--lime);color:var(--ink);margin-bottom:28px}.graphic-card-icon :global(svg){width:27px;height:27px}.graphic-capability-grid h3{font-size:27px;letter-spacing:-.03em;line-height:1.15;margin-bottom:20px}.graphic-capability-grid p{font-size:16px;line-height:1.65;color:#5d5b55}.graphic-selected-work{padding-block:75px}.graphic-selected-work :global(.project-caption p){color:#c7c5bd}.graphic-capabilities h2,.graphic-selected-work h2{font-size:clamp(32px,3.6vw,50px)}@media(max-width:1000px){.graphic-capability-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.graphic-capabilities,.graphic-selected-work{padding-block:45px}.graphic-capability-grid{grid-template-columns:1fr;gap:16px}.graphic-capability-grid article{padding:25px}.graphic-card-icon{margin-bottom:24px}.graphic-capabilities .section-heading>p{margin-top:20px}}
.web-edge-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(35px,5vw,75px);padding:0;overflow:hidden}.web-edge-hero .service-hero-image{order:-1;align-self:stretch;display:flex;align-items:center}.web-edge-hero .service-hero-image :global(.migrated-media){width:100%;padding:0;background:transparent}.web-edge-hero .service-hero-image :global(img){width:100%;height:auto;border-radius:0}.web-edge-hero .service-hero-copy{padding:55px max(56px,calc((100vw - 1320px)/2)) 55px 0}.web-edge-hero .service-hero-copy>p{color:#d4d0c6;font-size:16px}.web-edge-hero h1{font-size:clamp(38px,4.2vw,64px)}.web-examples{padding-block:75px}.web-examples h2{font-size:clamp(32px,3.6vw,50px)}.web-examples-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px 24px}.web-examples-grid :global(.project-caption h3){font-size:24px}.web-examples-grid :global(.project-caption p){font-size:13px;color:#66635d}.web-examples-grid :global(.project-number){display:none}.web-examples-grid :global(.project-image){border-radius:12px}.web-information{padding-block:75px}.web-information-heading{display:flex;justify-content:space-between;align-items:end;gap:45px;margin-bottom:40px}.web-information-heading h2{font-size:clamp(36px,4vw,56px)}.web-information-heading p{max-width:350px;color:#d4d0c6;font-size:16px}.web-information-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;align-items:start}.web-information-grid .web-information-card{background:#ffffff07;border:1px solid #ffffff25;border-radius:14px;padding:28px}.web-information-grid h3{font-size:27px;margin:0;color:var(--lime)}.web-information-card summary{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:64px;cursor:pointer;list-style:none}.web-information-card summary::-webkit-details-marker{display:none}.web-information-card summary>span{font-size:28px;color:var(--lime);line-height:1;transition:transform .2s}.web-information-card[open] summary>span{transform:rotate(45deg)}.web-information-card summary:focus-visible{outline:3px solid var(--lime);outline-offset:7px}.web-information-body{padding-top:22px}.web-information-grid p{font-size:15px;line-height:1.65;color:#d4d0c6}.web-information-grid p+p{margin-top:16px}.web-information-grid h4{font-size:16px;margin:20px 0 6px;font-weight:550}.web-information-grid .text-link{margin-top:22px;font-size:14px;gap:12px}@media(max-width:1000px){.web-information-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.web-edge-hero .service-hero-copy{padding-right:28px}.web-examples-grid{gap:30px 18px}}@media(max-width:760px){.web-edge-hero{grid-template-columns:1fr;gap:0}.web-edge-hero .service-hero-copy{padding:35px 20px 45px}.web-edge-hero h1{font-size:44px}.web-examples,.web-information{padding-block:45px}.web-examples-grid,.web-information-grid{grid-template-columns:1fr}.web-information-heading{display:block}.web-information-heading p{margin-top:20px}.web-information-grid .web-information-card{padding:25px}}
.web-stacked-hero .service-hero-image :global(img){transform:scale(1.22);transform-origin:left center}.web-stacked-hero{min-height:max(650px,90svh,calc(clamp(500px,48vw,720px) + 125px))}@media(max-width:1000px) and (min-width:761px){.web-stacked-hero .service-hero-image :global(img){transform:scale(1.22);transform-origin:left center}.web-stacked-hero{min-height:max(605px,85svh)}}@media(max-width:760px){.web-stacked-hero .service-hero-image :global(img){transform:scale(1.22);transform-origin:left center}.web-stacked-hero{min-height:0}.web-stacked-hero .service-hero-image :global(img){transform:none}.web-stacked-hero .service-hero-image{order:1}}
@media(max-width:760px){.web-stacked-hero .service-hero-image{order:1;min-height:0;padding:0 0 48px;overflow:hidden}.web-stacked-hero .service-hero-image :global(.migrated-media){width:100%;max-width:none}.web-stacked-hero .service-hero-image :global(img){display:block;width:100%;height:auto;max-width:none;transform:scale(1.14);transform-origin:center center}}

.industry-service-link{margin:-15px 0 35px;color:#59574f}.industry-service-link a{text-decoration:underline;text-underline-offset:4px}
</style>
