---
import MediaGallery from './MediaGallery.astro';
import ProjectCTA from './ProjectCTA.astro';
import Arrow from './Arrow.astro';
import Media from './Media.astro';
import ProjectCard from './ProjectCard.astro';
import portfolio from '../data/portfolio.json';
const {page}=Astro.props;
const names:Record<string,string>={'logo-design-springfield-il':'Brand identities & logo design.','web-design-springfield-il':'Websites built around your brand.','graphic-design-springfield-il':'Good design. Real purpose.','digital-marketing-springfield-il':'Make your next move count.'};
const intro=page.blocks.flat().find((x:{tag:string})=>x.tag==='p')?.text;
const sections=page.blocks.filter((b:{tag:string;text:string}[])=>b.some(x=>x.tag==='p')).map((b:{tag:string;text:string}[])=>b.filter(x=>x.text!==intro)).filter((b:unknown[])=>b.length);
const isWeb=page.slug==='web-design-springfield-il';
const hasCardToggles=isWeb||page.slug==='logo-design-springfield-il';
const webExamples=['/koke-mill-church','/project/equiventures-east','/project/kp','/the-villas','/colossus','/wholemoon'].map(path=>portfolio.find(project=>project.path===path)!);
const imageLeft=['web-design-springfield-il','digital-marketing-springfield-il'].includes(page.slug);
---
<section class:list={[isWeb?'web-edge-hero section-dark':'container service-hero',{'service-hero-image-left':imageLeft}]}>
 <div class="service-hero-copy"><a class="text-link" href="/services">Our services <Arrow /></a><h1>{names[page.slug]}</h1><p>{intro}</p><a class="button button-lime" href="/contact">Start a conversation <Arrow /></a></div>
 {page.gallery.length>0&&<div class="service-hero-image">{isWeb?<Media id={page.gallery[0].id} alt={page.gallery[0].alt} eager/>:<MediaGallery items={page.gallery.slice(0,1)} name={names[page.slug]}/>}</div>}
</section>
{isWeb&&<section class="container web-examples" aria-labelledby="web-examples-title"><div class="section-heading"><h2 id="web-examples-title">Websites with character.</h2><a class="text-link" href="/portfolio">Explore all work <Arrow/></a></div><div class="web-examples-grid">{webExamples.map(project=><ProjectCard {...project}/>)}</div></section>}
{sections.length>0&&<section class="container service-explainer"><div class="service-explainer-heading"><h2>{page.slug==='logo-design-springfield-il'?'More than a mark.':'What we can create.'}</h2></div><div class="service-explainer-content">{sections.map((b:{tag:string;text:string}[])=><article data-reveal>{b.map(x=>x.tag.startsWith('h')?<h3>{x.text}</h3>:<p>{x.text}</p>)}</article>)}</div></section>}
{hasCardToggles&&page.faqs.length>0&&<section class="web-information section-dark"><div class="container"><div class="web-information-heading"><h2>Process, pricing<br/><em>&amp; good questions.</em></h2><p>{isWeb?'Everything you need to know about building your next website.':'What to expect when creating your brand identity.'}</p></div><div class="web-information-grid">{page.faqs.map((f:{title:string;paragraphs:string[]})=><details class="web-information-card"><summary><h3>{f.title}</h3><span aria-hidden="true">+</span></summary><div class="web-information-body">{f.paragraphs.map((p,index)=>f.title==='Our Process'&&index%2===0?<h4>{p}</h4>:<p>{p.replace('Learn More →','').replace('launch.Need','launch. Need').replace('delivery.Need','delivery. Need').replace('Yeah – we do that. Want','Yeah – we do that. Want')}</p>)}{f.title==='Web Management Services'&&<a class="text-link" href="/brand-management-services">Explore management plans <Arrow/></a>}</div></details>)}</div></div></section>}
{!hasCardToggles&&page.faqs.length>0&&<section class="section-dark faq-section"><div class="container faq-grid"><div><p class="eyebrow">The details</p><h2>Process, pricing<br /><em>& good questions.</em></h2></div><div>{page.faqs.map((f:{title:string;paragraphs:string[]})=><details><summary>{f.title}<span aria-hidden="true">+</span></summary><div>{f.paragraphs.map(p=><p>{p.replace('Learn More →','').replace('launch.Need','launch. Need').replace('delivery.Need','delivery. Need')}</p>)}{f.title==='Web Management Services'&&<a class="text-link" href="/brand-management-services">Explore management plans <Arrow /></a>}</div></details>)}</div></div></section>}
{!isWeb&&page.gallery.length>1&&<section class="container case-section"><div class="section-heading"><div><p class="eyebrow">A few examples</p><h2>Made for real brands.</h2></div><a class="text-link" href="/portfolio">See the work <Arrow /></a></div><MediaGallery items={page.gallery.slice(1)} name={names[page.slug]} compact={page.slug==='logo-design-springfield-il'}/></section>}
<ProjectCTA/>

<style>
.web-edge-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(35px,5vw,75px);padding:0;overflow:hidden}.web-edge-hero .service-hero-image{order:-1;align-self:stretch;display:flex;align-items:center}.web-edge-hero .service-hero-image :global(.migrated-media){width:100%;padding:0;background:transparent}.web-edge-hero .service-hero-image :global(img){width:100%;height:auto;border-radius:0}.web-edge-hero .service-hero-copy{padding:55px max(56px,calc((100vw - 1320px)/2)) 55px 0}.web-edge-hero .service-hero-copy>p{color:#d4d0c6;font-size:16px}.web-edge-hero h1{font-size:clamp(38px,4.2vw,64px)}.web-examples{padding-block:75px}.web-examples h2{font-size:clamp(32px,3.6vw,50px)}.web-examples-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px 24px}.web-examples-grid :global(.project-caption h3){font-size:24px}.web-examples-grid :global(.project-caption p){font-size:13px;color:#66635d}.web-examples-grid :global(.project-number){display:none}.web-examples-grid :global(.project-image){border-radius:12px}.web-information{padding-block:75px}.web-information-heading{display:flex;justify-content:space-between;align-items:end;gap:45px;margin-bottom:40px}.web-information-heading h2{font-size:clamp(36px,4vw,56px)}.web-information-heading p{max-width:350px;color:#d4d0c6;font-size:16px}.web-information-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;align-items:start}.web-information-grid .web-information-card{background:#ffffff07;border:1px solid #ffffff25;border-radius:14px;padding:28px}.web-information-grid h3{font-size:27px;margin:0;color:var(--lime)}.web-information-card summary{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:64px;cursor:pointer;list-style:none}.web-information-card summary::-webkit-details-marker{display:none}.web-information-card summary>span{font-size:28px;color:var(--lime);line-height:1;transition:transform .2s}.web-information-card[open] summary>span{transform:rotate(45deg)}.web-information-card summary:focus-visible{outline:3px solid var(--lime);outline-offset:7px}.web-information-body{padding-top:22px}.web-information-grid p{font-size:15px;line-height:1.65;color:#d4d0c6}.web-information-grid p+p{margin-top:16px}.web-information-grid h4{font-size:16px;margin:20px 0 6px;font-weight:550}.web-information-grid .text-link{margin-top:22px;font-size:14px;gap:12px}@media(max-width:1000px){.web-information-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.web-edge-hero .service-hero-copy{padding-right:28px}.web-examples-grid{gap:30px 18px}}@media(max-width:760px){.web-edge-hero{grid-template-columns:1fr;gap:0}.web-edge-hero .service-hero-copy{padding:35px 20px 45px}.web-edge-hero h1{font-size:44px}.web-examples,.web-information{padding-block:45px}.web-examples-grid,.web-information-grid{grid-template-columns:1fr}.web-information-heading{display:block}.web-information-heading p{margin-top:20px}.web-information-grid .web-information-card{padding:25px}}
</style>
