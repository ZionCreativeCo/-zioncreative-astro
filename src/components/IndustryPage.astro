---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProjectCTA from './ProjectCTA.astro';
import ServiceIcon from './ServiceIcon.astro';
import IndustrySections from './IndustrySections.astro';
import '../styles/industry.css';
import {industryPages} from '../data/industry-pages';
interface Props {page:typeof industryPages[keyof typeof industryPages];}
const {page}=Astro.props;
const schema={'@context':'https://schema.org','@type':'Service','@id':`https://www.zioncreative.co/${page.slug}/#service`,name:'serviceType' in page?`${page.headline} ${page.serviceType}`:page.name,serviceType:'serviceType' in page?page.serviceType:`Website design and development for ${page.audience}`,description:page.description,url:`https://www.zioncreative.co/${page.slug}/`,provider:{'@type':'Organization','@id':'https://www.zioncreative.co/#organization',name:'Zion Creative',url:'https://www.zioncreative.co/'},areaServed:'areaServed' in page?page.areaServed:[{'@type':'City',name:'Springfield, Illinois'},{'@type':'Country',name:'United States'}]};
---
<BaseLayout title={page.title} description={page.description}><Header/><main id="main">
<section class="industry-hero section-dark"><div class="container industry-hero-grid"><div class="industry-copy"><p class="eyebrow">{page.name}</p><h1>{page.headline}<br/><em>{page.emphasis}</em></h1><p>{page.intro}</p><div class="industry-actions"><a class="button button-lime" href="/contact">{page.cta}</a><a class="text-link" href={'secondaryHref' in page?page.secondaryHref:'/pricing/#websites'}>{'secondaryLabel' in page?page.secondaryLabel:'Explore website pricing'}</a></div>{page.location&&<p class="industry-location">{page.location}</p>}</div><figure class="industry-visual"><a href={page.heroLink} aria-label={`Explore ${page.heroCaption}`}><img src={page.hero} srcset={page.heroMobile===page.hero?undefined:`${page.heroMobile} 640w, ${page.hero} 1280w`} sizes="(max-width:760px) 100vw, 48vw" width="1280" height="960" alt={page.heroAlt} loading="eager" fetchpriority="high" decoding="async"/></a><figcaption>{page.heroCaption}<a href={page.heroLink}>See the project</a></figcaption></figure></div></section>
<section class="container industry-intro"><h2>{page.introTitle}<br/><em>{page.introEmphasis}</em></h2><div>{page.introParagraphs.map(text=><p>{text}</p>)}</div></section>
<section class="industry-features"><div class="container"><div class="industry-heading"><h2>Thoughtful details.<br/><em>Meaningful next steps.</em></h2><p>{'featureIntro' in page?page.featureIntro:<>Website design and development shaped around your {'businessLabel' in page?page.businessLabel:page.audience==='churches'?'church':page.audience==='food and beverage businesses'?'business':'community'}.</>}</p></div><div class="industry-feature-grid">{page.features.map(feature=><article><span class="industry-icon"><ServiceIcon kind={feature.icon}/></span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div></div></section>
<section class="section-dark industry-work"><div class="container"><div class="industry-heading"><h2>{page.workTitle}<br/><em>{page.workEmphasis}</em></h2><p>{page.workIntro}</p></div><div class:list={['industry-work-grid',{'industry-work-single':page.projects.length===1}]}>{page.projects.map(project=><a class="industry-project" href={project.path}><div class="industry-project-image"><img src={`/images/${project.image}-1280.webp`} srcset={`/images/${project.image}-640.webp 640w, /images/${project.image}-1280.webp 1280w`} sizes={page.projects.length===1?'(max-width:760px) 100vw, 60vw':'(max-width:760px) 100vw, 45vw'} width="1280" height="960" alt={project.alt} loading="lazy" decoding="async"/></div><div class="industry-project-copy"><p class="eyebrow">Selected work</p><h3>{project.name}</h3><p>{project.text}</p><span class="text-link">Explore the case study</span></div></a>)}</div></div></section>
<section class="container industry-local"><div><p class="eyebrow">{'localEyebrow' in page?page.localEyebrow:'Local roots. Personal partnerships.'}</p><h2>{page.localTitle}<br/><em>{page.localEmphasis}</em></h2></div><div>{page.localParagraphs.map(text=><p>{text}</p>)}<a class="text-link" href="/about-us">Meet Zion Creative</a></div></section>
<IndustrySections page={page}/>
<ProjectCTA/></main><Footer/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></BaseLayout>
